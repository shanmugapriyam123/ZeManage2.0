<Window x:Class="BIManage.Addons.Views.NwcExport.BulkExportMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BIManage.Addons.ViewModels.NwcExport"
        Title="3D Views → NWC Export"
        Height="560" Width="850"
        WindowStartupLocation="CenterScreen"
        MinWidth="550" MinHeight="500"
        Background="#F8F9FA"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5500"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC4400"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#DEE2E6"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}"/>

        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="25,12"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                Focusable="False">
                                <Decorator x:Name="PART_ContentHost"
                                 Margin="12,8"
                                 VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#000000"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBorder"
                                    Width="18" Height="18"
                                    Background="White"
                                    BorderBrush="#ADB5BD"
                                    BorderThickness="1.5"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="checkMark"
                                      Data="M3,8 L7,12 L15,4"
                                      Stroke="#000000"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Margin="1"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Width="12" Height="12"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#F8F9FA"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" Margin="8">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Image x:Name="HeaderLogo" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="3D Views → NWC Export"
                              Style="{StaticResource SectionHeaderStyle}"
                              FontSize="17" VerticalAlignment="Center" Margin="0"/>
                </StackPanel>
                <Rectangle Height="2" Fill="#E9ECEF" Margin="30,0"/>
            </StackPanel>

            <!-- File Selection Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="1"
                       HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="📁 Local File"
                       Command="{Binding LocalFileCommand}"
                       Width="140" Height="40"
                       Style="{StaticResource ModernButtonStyle}"
                       Margin="0,0,15,0"/>
                <Button Content="☁️ ACC/BIM360"
                       Command="{Binding CloudFileCommand}"
                       Width="140" Height="40"
                       Style="{StaticResource SecondaryButtonStyle}" Click="Button_Click"/>
            </StackPanel>

            <!-- Export Folder -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="6"
                   Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Export Destination" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExportFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True"
                                Grid.Column="0"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Margin="0,0,10,0"/>
                        <Button Content="Browse..."
                               Grid.Column="1"
                               Width="100" Height="36"
                               Command="{Binding BrowseExportFolderCommand}"
                               Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Export Options -->
            <Border Grid.Row="3" Background="#FDFDFD"
                   BorderBrush="#E9ECEF" BorderThickness="1"
                   CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Export Options"
                                  Style="{StaticResource SectionHeaderStyle}"
                                  Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <CheckBox Content="Convert Element Properties" IsChecked="{Binding ConvertElementProperties}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Convert Lights" IsChecked="{Binding ConvertLights}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Convert Linked CAD (Revit 2020+)" IsChecked="{Binding ConvertLinkedCADFormats}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Split into Levels" IsChecked="{Binding DivideFileIntoLevels}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Export Element IDs" IsChecked="{Binding ExportElementIds}" Style="{StaticResource ModernCheckBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <CheckBox Content="Export Links" IsChecked="{Binding ExportLinks}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Export Parts" IsChecked="{Binding ExportParts}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Export Room As Attribute" IsChecked="{Binding ExportRoomAsAttribute}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Export Room Geometry" IsChecked="{Binding ExportRoomGeometry}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Export URLs" IsChecked="{Binding ExportUrls}" Style="{StaticResource ModernCheckBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <CheckBox Content="Find Missing Materials" IsChecked="{Binding FindMissingMaterials}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <CheckBox Content="Internal Coordinates" IsChecked="{Binding ExportInternalCoordinates}" Style="{StaticResource ModernCheckBoxStyle}"/>
                                <TextBlock Text="(Uncheck for Shared)"
                                          FontSize="11" Foreground="#6C757D" Margin="26,-2,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Faceting Factor:"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding FacetingFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="70" Height="32"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             local:NumericTextBoxBehavior.IsEnabled="True"
                                             local:NumericTextBoxBehavior.MinimumValue="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="📥 Import"
                            Width="100" Height="38"
                            Margin="0,0,8,0"
                            Command="{Binding ImportConfigCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="Load settings from a preset file"/>
                    <Button Content="📤 Export"
                            Width="100" Height="38"
                            Command="{Binding ExportConfigCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="Save current settings and selections to a .ze preset file"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🚀 Export to NWC"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding HasSelectedViews}"
                        Width="180" Height="38"
                        Style="{StaticResource ExportButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>

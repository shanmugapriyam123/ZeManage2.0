<Window x:Class="BIManage.Addons.Views.Common.ZeMessageBox"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIManage"
        Width="400" SizeToContent="Height"
        MinHeight="150" MaxHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F8FAFC"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="True">

    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0" Padding="14,10">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="LogoImage" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" Text="Title" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                            Click="Close_Click" Width="22" Height="22">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="11">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Message Body -->
            <Border Grid.Row="1" Padding="14,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <TextBlock x:Name="MessageText" Text="Message" FontSize="12" Foreground="#475569"
                               TextWrapping="Wrap" LineHeight="18"/>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,10,10" Padding="14,8">
                <Button x:Name="OkButton" Content="OK" Width="76" Height="30" HorizontalAlignment="Right"
                        Click="Ok_Click" Cursor="Hand" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="6" Padding="10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D3D3D3" Offset="0"/>
                                        <GradientStop Color="#D3D3D3" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF5500" Offset="0"/>
                                                <GradientStop Color="#FF5500" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="border" Property="TextElement.Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="#000000"/>
                    </Button.Foreground>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
	  <add key="ApiBaseUrl" value="http://10.10.40.75:5000" />
	  <add key="SignalR:HubUrl" value="http://10.10.40.75:5000/hubs/notifications" />
	  <add key="LoginUrl" value="https://zemanage.com/login" />
	  <add key="DashboardUrl" value="https://zemanage.com/dashboard" />
	  <add key="AnalyzerBaseUrl" value="https://zediag.zestinetech.com/" />
    <!-- AI Provider Configuration -->
    <!-- AI:ApiKey is INTENTIONALLY BLANK in source control. The provider falls back to
         the OPENAI_API_KEY environment variable (see OpenAIProvider.cs). Set it per machine:
           Windows GUI: System Properties → Environment Variables → New (User) → OPENAI_API_KEY
           PowerShell:  setx OPENAI_API_KEY "sk-proj-..."   (then restart Revit)
         Do NOT paste a real key into this file — it gets bundled into shipping installers. -->
    <add key="AI:Provider" value="openai" />
    <add key="AI:ApiKey" value="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" />
    <add key="AI:Model" value="gpt-4o-mini" />
    <!-- AI:UseBackendProxy — when true, AI chat requests go through the ZeManage backend's
         /api/v1/ai/chat endpoint (which fetches the OpenAI key from Azure Key Vault) instead
         of calling OpenAI directly. Leave false until the backend endpoint is live. Once
         enabled, the AI:ApiKey above can be blanked — the key stays in Key Vault and never
         ships in the DLL. See docs/implementation/BACKEND_AI_PROXY_SPEC.md for the backend
         contract this flag depends on. -->
    <add key="AI:UseBackendProxy" value="false" />
    <!-- Sync queue race protection. ClaimWaitMs is the time SyncCommandBinding waits
         between broadcasting its intent and arbitrating against peer claims (clamped
         [100, 3000]). FailClosedOnDisconnect blocks sync when SignalR is offline so
         clients on a flaky network don't race each other. Set to "false" only on
         single-user installs with no SignalR. -->
    <add key="SyncQueueControl:ClaimWaitMs" value="600" />
    <add key="SyncQueueControl:FailClosedOnDisconnect" value="true" />
    <!-- ZeManage Desktop Agent (R27 / net10.0 only) -->
    <add key="ZeManageAgent:BackendUrl" value="http://10.10.40.75:5000" />
    <add key="ZeManageAgent:Email" value="agent@conservesolution.com" />
    <add key="ZeManageAgent:Password" value="AgentSvc@12345" />
  </appSettings>
  <system.data>
    <DbProviderFactories>
      <remove invariant="System.Data.SQLite" />
      <add name="SQLite Data Provider" invariant="System.Data.SQLite" description=".NET Framework Data Provider for SQLite" type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
    </DbProviderFactories>
  </system.data>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Enable probing for x64/x86 subdirectories for SQLite.Interop.dll -->
      <probing privatePath="x64;x86" />
    </assemblyBinding>
  </runtime>
</configuration>
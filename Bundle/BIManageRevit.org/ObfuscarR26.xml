<?xml version='1.0'?>
<!--
  Obfuscar config: BIManageRevit R26 (net8.0-windows / Revit 2026).

  Mode: STRING HIDING ONLY. Every Rename* toggle is false because this
  codebase is renaming-hostile in ways the static analyzer cannot detect:

    1. Cross-module reflection - BIManage.Addons looks up
       BIManage.Revit.Protection.EventProtectionSuppression.BeginScope
       in BIManageRevit.dll via string-based GetMethod(...). Renaming
       the target silently breaks the NWC export's event suppression.
    2. Default-ALC guard at BIManage/Revit/Applications/Application.cs:73
       - depends on AssemblyLoadContext.GetLoadContext() seeing the
       assembly identity bytes unchanged. The Dotfuscator round-trip
       (which DID alter those bytes) broke this and surfaced as
       "Unable to access application services" toasts.
    3. WPF pack URIs - BAML hard-codes full type names like
       BIManageRevit.BIManage.Views.AI.ZestAiDialog. Renaming = IOException
       on InitializeComponent for every dialog.

  HideStrings replaces LDSTR opcodes with calls to a decoder method that
  reads from an XOR-encoded UTF8 byte array allocated on assembly init.
  Affects method bodies only, leaves assembly identity / type metadata
  / WPF pack URIs intact - exactly the protection profile that's safe
  here.

  Probe paths cover the transitive reference closure: net8 BCL refs from
  BIManageRevit.dll itself (8.0.27), Roslyn 4.8's net7.0 lib that walks
  into System.Runtime 7.0.0.0 (7.0.20), Azure / Material refs that target
  System.Runtime 6.0.0.0 (6.0.36), plus the WindowsDesktop.App variants
  for WPF (PresentationCore, PresentationFramework, WindowsBase).

  Revit 2026 install supplies RevitAPI.dll (26.x), RevitAPIUI.dll,
  AdWindows.dll - marked Private=False in the csproj so they're never
  deployed alongside the addin (Revit loads them from its own install)
  but the obfuscator still needs them for the reference closure scan.
-->
<Obfuscator>
  <Var name="InPath"           value="BIManageRevit.org\Contents\2026" />
  <Var name="OutPath"          value="BIManageRevit.org\Confused\2026" />
  <Var name="HideStrings"      value="true" />
  <Var name="KeepPublicApi"    value="true" />
  <Var name="HidePrivateApi"   value="false" />
  <Var name="RenameMethods"    value="false" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents"     value="false" />
  <Var name="RenameFields"     value="false" />
  <Var name="UseUnicodeNames"  value="false" />

  <AssemblySearchPath path="C:\Program Files\Autodesk\Revit 2026" />
  <AssemblySearchPath path="C:\Program Files\dotnet\shared\Microsoft.NETCore.App\8.0.27" />
  <AssemblySearchPath path="C:\Program Files\dotnet\shared\Microsoft.NETCore.App\7.0.20" />
  <AssemblySearchPath path="C:\Program Files\dotnet\shared\Microsoft.NETCore.App\6.0.36" />
  <AssemblySearchPath path="C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App\8.0.27" />
  <AssemblySearchPath path="C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App\6.0.36" />

  <Module file="BIManageRevit.org\Contents\2026\BIManageRevit.dll" />
  <Module file="BIManageRevit.org\Contents\2026\BIManage.Addons.dll" />
</Obfuscator>

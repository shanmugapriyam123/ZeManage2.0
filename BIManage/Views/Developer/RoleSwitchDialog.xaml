<Window x:Class="BIManageRevit.BIManage.Views.Developer.RoleSwitchDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch Role"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BIManageRevit;component/BIManage/Views/styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Standard title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logged-in user info banner -->
                <Border Grid.Row="0" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF5500" Offset="0"/>
                            <GradientStop Color="#E5611A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#10FFFFFF" VerticalAlignment="Center">
                            <TextBlock x:Name="UserInitialText" Text="U" Foreground="White" FontWeight="Bold"
                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="{Binding CurrentUserName, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="UserEmailText" Text="{Binding CurrentUserEmail, Mode=OneWay}"
                                       FontSize="10" Foreground="#80FFFFFF" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Title and Current Role -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B">
                        Your Role
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,4,0,0">
                        <Run Text="Active: "/>
                        <Run Text="{Binding CurrentRoleDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FF5500"/>
                    </TextBlock>
                </StackPanel>

                <!-- Role Selection Buttons -->
                <StackPanel Grid.Row="2">
                    <!-- SuperAdmin (Company Administrator) -->
                    <Button Click="SuperAdminButton_Click" Style="{StaticResource CommandLinkButton}"
                            x:Name="SuperAdminButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FF5500" CornerRadius="6"
                                    Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Super Admin" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="Full access across all projects" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="SuperAdminCheck" Text="&#x2713;" FontSize="16"
                                       Foreground="#22C55E" FontWeight="Bold" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <!-- Admin (Project Administrator) -->
                    <Button Click="AdminButton_Click" Style="{StaticResource CommandLinkButton}"
                            x:Name="AdminButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#16A34A" CornerRadius="6"
                                    Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Admin" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="Manage assigned projects" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="AdminCheck" Text="&#x2713;" FontSize="16"
                                       Foreground="#22C55E" FontWeight="Bold" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <!-- User (Normal User) -->
                    <Button Click="UserButton_Click" Style="{StaticResource CommandLinkButton}"
                            x:Name="UserButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#64748B" CornerRadius="6"
                                    Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="U" Foreground="White" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="User" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="Standard access with protections" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="UserCheck" Text="&#x2713;" FontSize="16"
                                       Foreground="#22C55E" FontWeight="Bold" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                    <TextBlock FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center">
                        Your role is assigned based on your login credentials.
                        Select a role to switch access level.
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

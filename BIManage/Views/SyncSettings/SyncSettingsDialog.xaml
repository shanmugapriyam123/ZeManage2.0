<Window x:Class="BIManageRevit.BIManage.Views.SyncSettings.SyncSettingsDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Settings"
        Width="780"
        SizeToContent="Height"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight"   Color="#E2E8F0"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Primary Gradient Button -->
        <Style x:Key="PrimaryGradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="#FF5500">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5611A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White Button -->
        <Style x:Key="WhiteButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section card style -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- Styled ComboBox -->
        <Style x:Key="UnitComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="8,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#94A3B8" StrokeThickness="1.5"
                                          Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0" Opacity="0"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0" Padding="2">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem style -->
        <Style x:Key="UnitComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Grid.Column="0" Width="18" Height="18"
                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                    CornerRadius="6" VerticalAlignment="Center">
                                <Path x:Name="check" Data="M3,7 L7,11 L13,3" Stroke="#FFFFFF" StrokeThickness="2"
                                      Stretch="Uniform" Width="10" Height="8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FF5500"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF5500"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF5500"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern RadioButton -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ring" Grid.Column="0" Width="18" Height="18"
                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                    CornerRadius="9" VerticalAlignment="Center">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#FF5500"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="#FF5500"/>
                                <Setter TargetName="ring" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="#FF5500"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled TextBox -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5500"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <Grid Grid.Row="1" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EFF6FF" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#x2699;" FontSize="15" Foreground="#000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sync Settings" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Background sync configuration"
                                       FontSize="10" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1" x:Name="BackgroundSyncForm" Margin="14,8,14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Background Sync + Schedule -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">

                        <!-- Background Sync -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F504;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Background Sync" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="12,8,12,10">
                                    <CheckBox IsChecked="{Binding IsBackgroundSyncEnabled}"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8">
                                        <TextBlock Text="Enable Background Sync" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </CheckBox>

                                    <TextBlock Text="SYNC MODE" FontSize="9" FontWeight="Bold"
                                               Foreground="#94A3B8" Margin="0,0,0,4"
                                               IsEnabled="{Binding IsBackgroundSyncEnabled}"/>
                                    <RadioButton IsChecked="{Binding SyncAllTheTime}"
                                                 IsEnabled="{Binding IsBackgroundSyncEnabled}"
                                                 Style="{StaticResource ModernRadioButton}" Margin="0,0,0,3">
                                        <TextBlock Text="On a schedule — sync at regular intervals" FontSize="11" Foreground="#1E293B"/>
                                    </RadioButton>
                                    <RadioButton IsChecked="{Binding SyncWhenPaused}"
                                                 IsEnabled="{Binding IsBackgroundSyncEnabled}"
                                                 Style="{StaticResource ModernRadioButton}" Margin="0,0,0,3">
                                        <TextBlock Text="When not in use — sync when you step away" FontSize="11" Foreground="#1E293B"/>
                                    </RadioButton>
                                    <TextBlock FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Choose how sync happens: at regular intervals, or only when you're away from the computer."/>

                                    <TextBlock Text="Sync every (minutes)" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SyncIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}"
                                             IsEnabled="{Binding IsBackgroundSyncEnabled}"/>
                                    <TextBlock Text="Default: 30" FontSize="9" Foreground="#94A3B8" Margin="0,2,0,6"/>

                                    <TextBlock Text="Wait before syncing (minutes)" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding IdleTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}"
                                             IsEnabled="{Binding ShowIdleOptions}"/>
                                    <TextBlock Text="How long to wait after you stop working before syncing. Default: 15"
                                               FontSize="9" Foreground="#94A3B8" Margin="0,2,0,6"/>

                                    <CheckBox IsChecked="{Binding SyncEvenIfNoChanges}"
                                              IsEnabled="{Binding IsBackgroundSyncEnabled}"
                                              Style="{StaticResource ModernCheckBox}">
                                        <TextBlock Text="Sync even when nothing has changed" FontSize="11" Foreground="#1E293B"/>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Compact Model -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4E6;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Compact Model" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="12,8,12,10">
                                    <CheckBox IsChecked="{Binding CompactModelOnceADay}"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6">
                                        <TextBlock Text="Reduce file size once a day" FontSize="11" Foreground="#1E293B"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding CompactAtNightOnly}"
                                              IsEnabled="{Binding CompactModelOnceADay}"
                                              Style="{StaticResource ModernCheckBox}" Margin="26,0,0,0">
                                        <TextBlock Text="Only during off-hours (12 AM – 6 AM)" FontSize="11" Foreground="#1E293B"/>
                                    </CheckBox>
                                    <TextBlock Text="Cleans up the central model to keep the file size small. Runs once per day."
                                               FontSize="9" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Exit Revit on Idle -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x23FB;" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B"/>
                                        <TextBlock Text="Auto-Close Revit" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="12,8,12,10">
                                    <CheckBox IsChecked="{Binding ExitRevitOnIdle}"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,0,0,4">
                                        <TextBlock Text="Close Revit when not in use" FontSize="11" Foreground="#1E293B"/>
                                    </CheckBox>
                                    <TextBlock Text="You'll see a 60-second countdown before Revit closes."
                                               FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="Exit after" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding ExitAfterHours, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}" Width="56"
                                                 IsEnabled="{Binding ExitRevitOnIdle}"/>
                                        <TextBlock Text="hr" FontSize="10" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="6,0,12,0"/>
                                        <TextBox Text="{Binding ExitAfterMins, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}" Width="56"
                                                 IsEnabled="{Binding ExitRevitOnIdle}"/>
                                        <TextBlock Text="min" FontSize="10" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Default: 24 hours" FontSize="9" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Right Column: Relinquish + Active Hours + Open Views -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">

                        <!-- Relinquish -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F513;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Relinquish" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="12,8,12,10">
                                    <CheckBox IsChecked="{Binding EnableRelinquish}"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6">
                                        <TextBlock Text="Automatically release element ownership" FontSize="11" Foreground="#1E293B"/>
                                    </CheckBox>
                                    <TextBlock Text="Releases your checked-out elements so others can edit them."
                                               FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="Release after idle (minutes)" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding RelinquishIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}"
                                             IsEnabled="{Binding EnableRelinquish}"/>
                                    <TextBlock Text="Default: 60" FontSize="9" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Active Hours -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F552;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Active Hours" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="12,8,12,10">
                                    <CheckBox IsChecked="{Binding EnableSchedule}"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6">
                                        <TextBlock Text="Only sync during specific hours" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </CheckBox>
                                    <StackPanel IsEnabled="{Binding EnableSchedule}">
                                        <TextBlock Text="Start Time (HH:mm)" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#64748B" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding ScheduleStartTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,6"/>
                                        <TextBlock Text="End Time (HH:mm)" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#64748B" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding ScheduleEndTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}"/>
                                    </StackPanel>
                                    <TextBlock Text="Supports overnight hours (e.g. 9 PM to 9 AM)."
                                               FontSize="9" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Open Views -->
                        <Border Style="{StaticResource SectionCard}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569"/>
                                        <TextBlock Text="Open Views" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="12,8,12,10">
                                    <TextBlock Text="Specify what to do with open views" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding OpenViewsOnSyncMode, Mode=TwoWay}"
                                              Height="32" FontSize="11"
                                              Padding="10,6"
                                              BorderBrush="#CBD5E1"
                                              BorderThickness="1"
                                              Background="White"
                                              Foreground="#1E293B"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,0,4">
                                        <ComboBoxItem Content="Keep them open" Padding="10,6"/>
                                        <ComboBoxItem Content="Close all views" Padding="10,6"/>
                                        <ComboBoxItem Content="Close all views and reopen after sync" Padding="10,6"/>
                                    </ComboBox>
                                    <TextBlock Text="Default: Keep them open" FontSize="9" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                    <!-- Warning note -->
                                    <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="#92400E" VerticalAlignment="Top" Margin="0,1,6,0"/>
                                            <TextBlock FontSize="10" Foreground="#78350F" TextWrapping="Wrap"
                                                       Text="Keeping multiple views opened during syncing will increase the sync time by a lot."/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Prevent from syncing when more than ___ views are opened"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#64748B"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PreventSyncViewsTextBox"
                                             Text="{Binding PreventSyncWhenViewsOpenedOver, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource InputTextBox}" HorizontalAlignment="Stretch"
                                             PreviewTextInput="PreventSyncViewsTextBox_PreviewTextInput"
                                             TextChanged="PreventSyncViewsTextBox_TextChanged"
                                             LostFocus="PreventSyncViewsTextBox_LostFocus"/>
                                    <TextBlock Text="Minimum: 2 • Default: 10" FontSize="9" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource WhiteButton}" Width="76"
                                    Margin="0,0,6,0" Click="Export_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2191;" FontSize="10" Foreground="#475569" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Export" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WhiteButton}" Width="76"
                                    Click="Import_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2193;" FontSize="10" Foreground="#475569" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Import" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="10,4"/>

                        <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="Save" Style="{StaticResource PrimaryGradientButton}" Width="76"
                                    Margin="0,0,6,0" Click="Save_Click"/>
                            <Button Content="Close" Style="{StaticResource WhiteButton}" Width="76" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Success Toast -->
                <Border x:Name="SuccessPopup" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,20,0,0" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="12" MinWidth="280" MaxWidth="400"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                                <TextBlock Text="&#x2713;" FontSize="16" FontWeight="Bold" Foreground="#22C55E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SuccessTitle" Text="Saved" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock x:Name="SuccessMessage" Text="Settings saved successfully"
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

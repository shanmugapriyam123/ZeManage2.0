<Window x:Class="BIManageRevit.BIManage.Views.Auth.LicenseWarningToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Border Background="White" CornerRadius="10" Margin="8" ClipToBounds="True"
            BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.15"/>
        </Border.Effect>

        <Grid Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBackground" Grid.Column="0" Background="#FEF3C7" Width="34" Height="34" CornerRadius="6"
                    VerticalAlignment="Top" Margin="0,0,10,0">
                <TextBlock x:Name="IconGlyph" Text="!" FontSize="16" FontWeight="Bold"
                           Foreground="#B45309"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="License Notice" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>
                <TextBlock x:Name="MessageText" Text="" FontSize="10" Foreground="#475569"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="2" Click="Close_Click" Cursor="Hand"
                    VerticalAlignment="Top" Width="20" Height="20" Margin="4,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                            <TextBlock Text="X" FontSize="10" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>

<Window x:Class="BIManageRevit.BIManage.Views.Auth.DeviceStatusDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage - Device Status"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="28,24">
                <!-- Status Icon -->
                <Border x:Name="StatusCircle" Width="56" Height="56" CornerRadius="28"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock x:Name="StatusIcon" FontSize="26" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Info Card -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="16,14" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <!-- Machine ID -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Machine ID" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="MachineIdText" Grid.Column="1" FontSize="10" Foreground="#475569"
                                       FontFamily="Consolas" TextWrapping="NoWrap"/>
                        </Grid>

                        <!-- Company Name -->
                        <Grid x:Name="CompanyRow" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Company" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="CompanyText" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E293B"/>
                        </Grid>

                        <!-- Device Status -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="StatusValue" Grid.Column="1" FontSize="10" FontWeight="Bold"/>
                        </Grid>

                        <!-- License Mode -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="License" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="LicenseModeText" Grid.Column="1" FontSize="10" FontWeight="Bold" Text="—"/>
                        </Grid>

                        <!-- Seats (hidden when not available) -->
                        <Grid x:Name="SeatsRow" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Seats" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="SeatsText" Grid.Column="1" FontSize="10" Foreground="#475569"/>
                        </Grid>

                        <!-- Role (hidden for non-admins) -->
                        <Grid x:Name="RoleRow" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Role" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="RoleText" Grid.Column="1" FontSize="10" Foreground="#475569"/>
                        </Grid>

                        <!-- Modules -->
                        <Grid x:Name="ModulesRow" Margin="0,0,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Modules" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Top"/>
                            <TextBlock x:Name="ModulesText" Grid.Column="1" FontSize="10" Foreground="#475569" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Last checked -->
                <TextBlock x:Name="LastCheckedText" Text="Checking server..." FontSize="9" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <!-- Re-enter License Button (shown when breached) -->
                <Button x:Name="ReenterLicenseBtn" Width="160" Height="36" Click="ReenterLicense_Click" Cursor="Hand"
                        HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="6" Background="#EF5350">
                                <TextBlock Text="Re-enter License Key" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#E53935"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Close Button -->
                <Button Width="100" Height="36" Click="Close_Click" Cursor="Hand" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="6" Background="White"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" Foreground="#212121"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                    <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="BIManageRevit.BIManage.Views.Auth.LicenseKeyDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage - Device Registration"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="24,20,24,20">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Background="#FEF2F2" Width="40" Height="40" CornerRadius="6" Margin="0,0,14,0">
                        <TextBlock Text="🔑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Device Registration" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="This device is not registered" FontSize="11" Foreground="#DC2626"/>
                    </StackPanel>
                </StackPanel>

                <!-- Info -->
                <Border Background="#FFF3E0" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#9A3412">
                        Enter the license key provided by your administrator to activate this device.
                    </TextBlock>
                </Border>

                <!-- License Key Input -->
                <TextBlock Text="License Key" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                <TextBox x:Name="LicenseKeyInput" FontSize="13" Padding="10,8"
                         BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                         TextChanged="LicenseKeyInput_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Machine ID (read-only) -->
                <TextBlock Text="Machine ID" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,12,0,4"/>
                <TextBlock x:Name="MachineIdText" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas" TextWrapping="Wrap"/>

                <!-- Buttons -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel — Secondary style -->
                    <Button Grid.Column="1" Width="80" Height="36"
                            Margin="0,0,8,0" Click="Cancel_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="6" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <TextBlock Text="Cancel" FontSize="13" FontWeight="SemiBold" Foreground="#212121"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Activate — Primary style (#FF5500) -->
                    <Button x:Name="ActivateButton" Grid.Column="2" Width="100" Height="36"
                            IsEnabled="False" Click="Activate_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="6" Background="#FF5500">
                                    <TextBlock Text="Activate" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#E5611A"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

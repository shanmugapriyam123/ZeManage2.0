<Window x:Class="BIManageRevit.BIManage.Views.Metrics.AnalyzeModelDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Analysis"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5500"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#FF5500" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5611A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC4400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <!-- Main Container -->
            <Grid Grid.Row="1" Background="White">
                <!-- Confirmation Section (hidden by default for loading mode) -->
                <Grid x:Name="ConfirmationSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,16,24,12" VerticalAlignment="Center">
                        <TextBlock Text="Check Your Model Health?" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ModelNameText" Text="No document loaded" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="370"/>
                        <StackPanel Margin="40,0,40,10">
                            <TextBlock FontSize="10" Foreground="#475569" Margin="0,0,0,4"
                                       Text="&#x2022;  Model overview &#x2014; file size, warnings, views, sheets, families"/>
                            <TextBlock FontSize="10" Foreground="#475569" Margin="0,0,0,4"
                                       Text="&#x2022;  Element check &#x2014; element counts, rooms, MEP connections"/>
                            <TextBlock FontSize="10" Foreground="#475569"
                                       Text="&#x2022;  Cleanup opportunities &#x2014; oversized families, unused elements"/>
                        </StackPanel>
                        <TextBlock Text="Results will be available in the Model Health dashboard."
                                   FontSize="10" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,10"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="350"/>
                        <CheckBox x:Name="DetailedReportCheck" IsChecked="False" Margin="0,0,0,10"
                                  HorizontalAlignment="Center" Cursor="Hand">
                            <TextBlock FontSize="11" Foreground="#475569" FontWeight="Medium"
                                       Text="Generate Detailed Report after analysis"/>
                        </CheckBox>
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="12,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;" FontSize="12" Foreground="#D97706" VerticalAlignment="Center"/>
                                <TextBlock Text="This may take a few minutes on large models" FontSize="11" Foreground="#92400E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Button x:Name="NoButton" Content="Cancel" Style="{StaticResource ModernSecondaryButton}" Width="100" Click="NoButton_Click"/>
                        <Button x:Name="YesButton" Content="Start" Style="{StaticResource ModernPrimaryButton}" Width="100" Margin="12,0,0,0" Click="YesButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Loading Section (visible by default) -->
                <Grid x:Name="LoadingSection" Background="#F8FAFC" MinHeight="220">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,24">
                        <TextBlock x:Name="LoadingText" Text="Checking Your Model" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LoadingDetailText" Text="Please wait..." FontSize="12"
                                   Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,20"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>

                        <!-- Progress bar -->
                        <Grid Width="320" Height="10">
                            <Border Background="#E2E8F0" CornerRadius="6"/>
                            <Border x:Name="ProgressFill" Background="#FF5500" CornerRadius="6"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="12" Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>

                        <!-- Container for dynamically-added buttons (Yes/Skip/Cancel during family-scan flow).
                             Lives INSIDE the StackPanel so it appears BELOW the progress bar and 0% text
                             instead of overlapping them. -->
                        <StackPanel x:Name="FamilyScanButtonsContainer"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"/>

                        <!-- Persistent Cancel button for the synchronous AnalyzeModelMetricsCommand flow.
                             The chunked analyzer flow (ChunkedMetricsAnalyzer) hides this and uses
                             FamilyScanButtonsContainer for its own contextual Yes/Skip/Cancel buttons. -->
                        <Button x:Name="LoadingCancelButton"
                                Content="Cancel"
                                Width="100" Height="36"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Cursor="Hand"
                                FontWeight="SemiBold"
                                Click="LoadingCancelButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextBlock.Foreground="#475569"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                            <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bg" Property="Background" Value="#F8FAFC"/>
                                            <Setter TargetName="bg" Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Hidden for compatibility -->
                        <ProgressBar x:Name="ProgressBar" Visibility="Collapsed"/>
                        <Ellipse x:Name="LoadingSpinner" Visibility="Collapsed">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="LoadingLogo" Visibility="Collapsed"/>
                        <Ellipse x:Name="MiddleRing" Visibility="Collapsed">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                </Grid>

                <!-- Results Section -->
                <Grid x:Name="ResultsSection" Visibility="Collapsed">
                    <TextBlock x:Name="ResultModelName" Visibility="Collapsed"/>
                    <TextBlock x:Name="ResultCapturedTime" Visibility="Collapsed"/>
                    <TextBlock x:Name="ResultCaptureId" Visibility="Collapsed"/>
                    <TextBlock x:Name="ResultFamiliesOver5Mb" Visibility="Collapsed"/>
                    <TextBlock x:Name="ResultPurgeableElements" Visibility="Collapsed"/>
                    <Button x:Name="CloseButton" Visibility="Collapsed" Click="CloseButton_Click"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,20">
                        <Border Background="#DCFCE7" CornerRadius="50" Width="50" Height="50" HorizontalAlignment="Center">
                            <TextBlock Text="&#x2713;" FontSize="24" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Analysis Complete" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,12,0,6"/>
                        <TextBlock Text="Your model has been checked and results are saved." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock FontSize="11" HorizontalAlignment="Center">
                            <Run Text="Open " Foreground="#475569"/>
                            <Hyperlink x:Name="ModelHealthLink" Click="ModelHealthLink_Click"
                                       Foreground="#FF5500" FontWeight="SemiBold" TextDecorations="Underline"
                                       Cursor="Hand">Model Health</Hyperlink>
                            <Run Text=" to view the latest results." Foreground="#475569"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Error Section -->
                <Grid x:Name="ErrorSection" Visibility="Collapsed">
                    <Button x:Name="ErrorCancelButton" Visibility="Collapsed" Click="ErrorCancelButton_Click"/>
                    <Button x:Name="RetryButton" Visibility="Collapsed" Click="RetryButton_Click"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Background="#FEE2E2" CornerRadius="50" Width="50" Height="50" HorizontalAlignment="Center">
                            <TextBlock Text="✕" FontSize="20" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Analysis Failed" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock x:Name="ErrorMessageText" Text="" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                    </StackPanel>
                </Grid>

                <!-- Hidden CloseWindowButton for code-behind compatibility -->
                <Button x:Name="CloseWindowButton" Visibility="Collapsed" Click="CloseWindowButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

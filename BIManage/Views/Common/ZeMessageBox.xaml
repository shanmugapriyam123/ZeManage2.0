<Window x:Class="BIManage.Views.Common.ZeMessageBox"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage"
        Width="400" SizeToContent="Height"
        MinHeight="150" MaxHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="True">

    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid Height="36">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="LogoImage" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                               Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
                        <TextBlock x:Name="TitleText" Text="Title" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                            Click="Close_Click" Width="28" Height="28" BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6"
                                        Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Message Body -->
            <Border Grid.Row="1" Padding="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <TextBlock x:Name="MessageText" Text="Message" FontSize="12" Foreground="#475569"
                               TextWrapping="Wrap" LineHeight="18"/>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,10,10"
                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
                <Button x:Name="OkButton" Content="OK" MinWidth="80" Height="36" HorizontalAlignment="Right"
                        Click="Ok_Click" Cursor="Hand" IsDefault="True" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="6" Padding="16,0"
                                    Background="#FF5500">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E5611A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="BIManageRevit.BIManage.Views.SyncTrafficControl.SyncConflictDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync In Progress"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BIManageRevit;component/BIManage/Views/styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Standard title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Warning Icon + Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#FEF3C7" Margin="0,0,12,0">
                        <TextBlock Text="&#x26A0;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#D97706"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sync In Progress" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock x:Name="ModelNameText" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Info Card -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="{Binding BlockedByUsername, Mode=OneTime}"/>
                            <Run Text=" is currently syncing this model."/>
                        </TextBlock>
                        <TextBlock x:Name="DurationText" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Live status: shown when blocker finishes -->
                <Border x:Name="ReadyBorder" Grid.Row="2" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ReadyText" FontSize="12" Foreground="#166534" FontWeight="SemiBold"
                               Text="Sync completed — proceeding automatically..."/>
                </Border>

                <!-- Explanation -->
                <TextBlock x:Name="ExplanationText" Grid.Row="3" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,20">
                    To avoid merge conflicts, only one user can sync at a time.
                    You can join the queue and sync automatically when it's your turn.
                </TextBlock>

                <!-- Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click" Margin="0,0,10,0"/>
                    <Button Content="Join Queue" Style="{StaticResource PrimaryButton}"
                            Click="JoinQueueButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

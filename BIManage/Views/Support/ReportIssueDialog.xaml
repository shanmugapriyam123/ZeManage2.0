<Window x:Class="BIManageRevit.BIManage.Views.Support.ReportIssueDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage - Support Centre"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_KeyDown">

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Success Toast (hidden by default) -->
                <Border x:Name="SuccessOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="10"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="White" CornerRadius="6" MinWidth="320" MaxWidth="380"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel Margin="28,24">
                        <Border Background="#DCFCE7" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#16A34A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ticket Submitted!" FontSize="16" FontWeight="Bold" Foreground="#1E293B"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SuccessIdText" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SuccessTitleText" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,14"/>
                        <Button Width="100" Height="36" Click="Cancel_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="closeBg" CornerRadius="6" Background="#FF5500">
                                        <TextBlock Text="Done" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="closeBg" Property="Background" Value="#E5611A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Header -->
                <Border Grid.Row="0" Padding="24,16" Background="#FF5500">
                    <StackPanel>
                        <TextBlock Text="Support Centre" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Tell us what went wrong. We'll take care of it." FontSize="10" Foreground="White" Margin="0,3,0,0" Opacity="0.85"/>
                    </StackPanel>
                </Border>

                <!-- Form Content -->
                <StackPanel Grid.Row="1" Margin="24,20,24,24">

                    <!-- Title -->
                    <TextBlock Text="TITLE" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <TextBox x:Name="TitleInput" FontSize="13" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1"
                             Background="White" TextChanged="Input_TextChanged">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>

                    <!-- Module + Priority row -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MODULE" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ModuleCombo" FontSize="12" Padding="10,8" BorderBrush="#E2E8F0" Background="White">
                                <ComboBoxItem Content="Protection"/>
                                <ComboBoxItem Content="Activity Tracker"/>
                                <ComboBoxItem Content="Health Monitor"/>
                                <ComboBoxItem Content="Sync Control"/>
                                <ComboBoxItem Content="AI"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PRIORITY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <ComboBox x:Name="PriorityCombo" FontSize="12" Padding="10,8" BorderBrush="#E2E8F0" Background="White" SelectedIndex="2">
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Low"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="DESCRIPTION" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,14,0,5"/>
                    <TextBox x:Name="DescriptionInput" FontSize="13" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1"
                             Background="White" MinHeight="90" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextChanged="Input_TextChanged">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>

                    <!-- System Info Card -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="14,12" Margin="0,14,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xf085;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SYSTEM INFO" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock x:Name="SystemInfoText" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" FontFamily="Consolas" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Log Attachment Info -->
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                            BorderBrush="#BFDBFE" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📎" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" Text="Log file will be attached automatically"/>
                                <TextBlock x:Name="LogFileName" FontSize="9" Foreground="#3B82F6" Text=""/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hidden checkbox (always true) -->
                    <CheckBox x:Name="AttachLogCheck" IsChecked="True" Visibility="Collapsed"/>

                    <!-- Status -->
                    <TextBlock x:Name="StatusText" FontSize="10" Foreground="#16A34A" FontWeight="SemiBold"
                               Margin="0,12,0,0" Visibility="Collapsed"/>

                    <!-- Separator -->
                    <Border Height="1" Background="#F1F5F9" Margin="0,16,0,0"/>

                    <!-- Buttons -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="Cancel" Width="90" Height="36"
                                Margin="0,0,10,0" Click="Cancel_Click" Cursor="Hand" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextBlock.Foreground="#212121"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                            <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="SubmitButton" Grid.Column="2" Width="140" Height="36"
                                BorderThickness="0" IsEnabled="False" Click="Submit_Click" Cursor="Hand"
                                FontWeight="Bold" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" CornerRadius="6" Padding="16,0" Background="#FF5500">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextBlock.Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bg" Property="Background" Value="#D3D3D3"/>
                                            <Setter Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#E5611A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Submit Request" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

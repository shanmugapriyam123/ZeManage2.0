<Window x:Class="BIManageRevit.BIManage.Views.Support.SupportDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage Support"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Background="#EFF6FF" Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ZeManage Support" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Get help, report issues, or visit our website" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Button 1: ZestineTech Website -->
                <Button Click="Website_Click" Cursor="Hand" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#EFF6FF" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ZestineTech" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="Visit our website for product info and updates" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter TargetName="border" Property="Background" Value="#F0F7FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Button 2: Documentation (Admin only) -->
                <Button x:Name="DocumentationButton" Click="Documentation_Click" Cursor="Hand" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F0FDF4" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock Text="📖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Documentation" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="Plugin user guide and feature documentation" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#16a34a"/>
                                    <Setter TargetName="border" Property="Background" Value="#F0FDF4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Button 3: Support Centre -->
                <Button Click="ReportIssue_Click" Cursor="Hand" Margin="0,0,0,14">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FEF2F2" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock Text="🎫" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Support Centre" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="Raise a support ticket with auto-filled system info" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#dc2626"/>
                                    <Setter TargetName="border" Property="Background" Value="#FEF2F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Version info -->
                <TextBlock x:Name="VersionText" FontSize="9" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

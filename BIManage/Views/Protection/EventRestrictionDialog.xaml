<Window x:Class="BIManageRevit.BIManage.Views.Protection.EventRestrictionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage - Action Restricted"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        PreviewKeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1">
                <!-- Semantic red gradient header — kept as visual warning indicator -->
                <Border Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#DC2626" Offset="0"/>
                            <GradientStop Color="#B91C1C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFFFFF" Width="36" Height="36" CornerRadius="6" Margin="0,0,14,0" Opacity="0.15"/>
                        <TextBlock Text="🛡" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="-46,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" Text="Action Restricted" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="HeaderSubtitle" Text="" FontSize="10" Foreground="#FECACA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Body -->
                <StackPanel Margin="24,18,24,20">
                    <!-- Warning box -->
                    <Border Background="#FEF2F2" CornerRadius="6" Padding="14,12" Margin="0,0,0,16"
                            BorderBrush="#FECACA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="ProtectionMessage" TextWrapping="Wrap" FontSize="12" Foreground="#991B1B" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Auth info -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="14,10" Margin="0,0,0,16"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBlock Text="This action requires administrator authorization.&#x0a;Enter an OTP code from your BIM administrator to proceed."
                                   TextWrapping="Wrap" FontSize="11" Foreground="#475569" LineHeight="17"/>
                    </Border>

                    <!-- Comment input -->
                    <StackPanel x:Name="CommentSection" Margin="0,0,0,14">
                        <TextBlock x:Name="CommentLabel" Text="Reason / Comment (optional)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBox x:Name="CommentBox" MinHeight="60" MaxHeight="100"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"
                                 Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1"
                                 Background="White"/>
                    </StackPanel>

                    <!-- Action buttons (card-link style — already well-styled, keeping as-is) -->
                    <Button x:Name="OtpButton" Click="EnterOtp_Click" Cursor="Hand" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="6" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#EFF6FF" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0">
                                            <TextBlock Text="🔑" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Enter OTP Code" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="Enter a one-time password from your BIM administrator" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock Text="→" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                                        <Setter TargetName="bg" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Admin Override button (hidden by default) -->
                    <Button x:Name="AdminOverrideButton" Click="AdminOverride_Click" Cursor="Hand" Margin="0,0,0,8" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="6" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#F0FDF4" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0">
                                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Admin Override" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="Proceed as administrator without OTP" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock Text="→" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#22C55E"/>
                                        <Setter TargetName="bg" Property="Background" Value="#F0FDF4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="Cancel_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="6" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#FEF2F2" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0">
                                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#DC2626"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Cancel" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="Cancel this action" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#DC2626"/>
                                        <Setter TargetName="bg" Property="Background" Value="#FEF2F2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Footer -->
                    <Border Margin="0,14,0,0" Background="#FFF9C4" CornerRadius="6" Padding="10,8"
                            BorderBrush="#FDE047" BorderThickness="1">
                        <TextBlock Text="⚠ This action will be logged for audit purposes." FontSize="10"
                                   Foreground="#92400E" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

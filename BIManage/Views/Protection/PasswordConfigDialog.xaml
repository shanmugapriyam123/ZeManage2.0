<Window x:Class="BIManage.Views.Protection.PasswordConfigDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configure Override Password"
        Height="520" Width="570"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Primary Button Style (#FF5500) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5500"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E5611A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Background="#F5F5F5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sub-header -->
                <Border Grid.Row="0" Background="#F8FAFC" Padding="20,14"
                        BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="🔐 Configure Override Password" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Set the password required to override protection rules"
                                   FontSize="12" Foreground="#475569" Margin="0,4,0,0" Opacity="0.9"/>
                    </StackPanel>
                </Border>

                <!-- Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25">
                    <StackPanel>
                        <!-- Current Password (if password is already set) -->
                        <Border Background="White" Padding="20" CornerRadius="6" Margin="0,0,0,15"
                                Visibility="{Binding IsPasswordSet, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Current Password *" FontSize="13" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="CurrentPasswordBox"
                                             Padding="10"
                                             FontSize="13"
                                             PasswordChanged="OnCurrentPasswordChanged"/>
                                <TextBlock Text="Required to change the password"
                                           FontSize="10" Foreground="#9E9E9E" Margin="0,4,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- New Password -->
                        <Border Background="White" Padding="20" CornerRadius="6" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="New Password *" FontSize="13" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="NewPasswordBox"
                                             Padding="10"
                                             FontSize="13"
                                             PasswordChanged="OnNewPasswordChanged"/>

                                <!-- Password Strength Indicator -->
                                <Grid Margin="0,8,0,0" Visibility="{Binding NewPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Strength:" FontSize="11" Foreground="#757575" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthText}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding PasswordStrengthColor}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Minimum 6 characters. Use a mix of uppercase, lowercase, numbers, and special characters."
                                           FontSize="10" Foreground="#9E9E9E" Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- Confirm Password -->
                        <Border Background="White" Padding="20" CornerRadius="6" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Confirm Password *" FontSize="13" FontWeight="SemiBold" Foreground="#212121" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Padding="10"
                                             FontSize="13"
                                             PasswordChanged="OnConfirmPasswordChanged"/>
                                <TextBlock Text="Re-enter the new password"
                                           FontSize="10" Foreground="#9E9E9E" Margin="0,4,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- Status Message -->
                        <Border Background="#F8FAFC" Padding="15" CornerRadius="6"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="#EF5350"/>
                                                    <Setter Property="Text" Value="⚠"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="#EF5350"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="White" Padding="20,14" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Click="OnCancelClick"
                                Margin="0,0,10,0"/>
                        <Button Content="Save Password"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnSaveClick"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

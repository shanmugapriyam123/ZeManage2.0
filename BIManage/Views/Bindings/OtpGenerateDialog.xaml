<Window x:Class="BIManageRevit.BIManage.Views.Bindings.OtpGenerateDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate OTP"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown">

    <Border Margin="10" CornerRadius="10" Background="White" ClipToBounds="True"
            BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Border Grid.Row="0" Background="#F8FAFC"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderTitle"
                                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Close_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent"
                                        CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="16,14,16,16">

                <!-- OTP Code Display Box -->
                <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF5500" Offset="0"/>
                            <GradientStop Color="#E5611A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="O T P  C O D E" FontSize="9" FontWeight="SemiBold"
                                       Foreground="White" Opacity="0.8" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtOtpCode" Text="- - - - - -"
                                       FontSize="28" FontWeight="ExtraBold"
                                       Foreground="White" FontFamily="Consolas"/>
                        </StackPanel>

                        <!-- Copy Button (visible after generation) -->
                        <Button x:Name="BtnCopy" Grid.Column="1"
                                Click="CopyCode_Click" Cursor="Hand"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="copyBg" Background="#26FFFFFF"
                                            CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="White"
                                                       Margin="0,0,5,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CopyText" Text="Copy"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="copyBg" Property="Background"
                                                    Value="#40FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Expiry Row (visible after generation) -->
                <Grid x:Name="ExpiryRow" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Expires in"
                               FontSize="12" Foreground="#6B7280"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtExpiry" Grid.Column="1"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#111827" VerticalAlignment="Center"/>
                </Grid>

                <!-- Reason Input -->
                <StackPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Reason" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#374151"/>
                        <TextBlock Text=" (Optional)" FontSize="10"
                                   Foreground="#9CA3AF" FontStyle="Italic"
                                   VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                    </StackPanel>
                    <TextBox x:Name="ReasonTextBox"
                             MinHeight="60" MaxHeight="80"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8,6" FontSize="12"
                             BorderThickness="1" Background="White">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF5500"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- Error Message -->
                <Border x:Name="ErrorBorder" Visibility="Collapsed"
                        Background="#FEF2F2" BorderBrush="#FECACA"
                        BorderThickness="1" CornerRadius="6"
                        Padding="10,6" Margin="0,0,0,10">
                    <TextBlock x:Name="ErrorText" FontSize="11"
                               Foreground="#DC2626" TextWrapping="Wrap"/>
                </Border>

                <!-- Action Button -->
                <Button x:Name="ActionButton" Click="ActionButton_Click"
                        Cursor="Hand" Height="36" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" CornerRadius="6"
                                    Height="{TemplateBinding Height}"
                                    Background="#FF5500"
                                    BorderThickness="0">
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E5611A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Content>Generate OTP</Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

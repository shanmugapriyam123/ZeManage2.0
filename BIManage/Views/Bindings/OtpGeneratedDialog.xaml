<Window x:Class="BIManageRevit.BIManage.Views.Bindings.OtpGeneratedDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OTP Generated"
        Width="380"
        Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BIManageRevit;component/BIManage/Views/styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Standard title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                           Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="One-Time Password"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Secure bypass code generated"
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <!-- OTP Code Display Card with Copy Button -->
                    <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF5500" Offset="0"/>
                                <GradientStop Color="#E5611A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- OTP Code -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="OTP CODE" FontSize="8" FontWeight="SemiBold"
                                           Foreground="White" Opacity="0.8" Margin="0,0,0,1"/>
                                <TextBlock x:Name="TxtOtpCode" FontSize="28" FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>

                            <!-- Copy Button -->
                            <Button x:Name="BtnCopy" Grid.Column="1" Click="CopyCode_Click"
                                    Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right"
                                    ToolTip="Copy OTP code to clipboard" Width="72">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CopyBorder" Background="White" CornerRadius="6" Padding="8,6"
                                                BorderBrush="#E0E0E0" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock x:Name="CopyIcon" Text="&#x1F4CB;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CopyText" Text="Copy" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#344054" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CopyBorder" Property="Background" Value="#F2F4F7"/>
                                                <Setter TargetName="CopyBorder" Property="BorderBrush" Value="#98A2B3"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CopyBorder" Property="Background" Value="#E4E7EC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Details Card -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Valid For -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="&#x23F0;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Valid for" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtValidFor" Grid.Row="0" Grid.Column="1" Text="24 hours"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,5"/>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#F1F5F9" Margin="0,0,0,5"/>

                            <!-- Expires -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="&#x1F4C5;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Expires" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtExpires" Grid.Row="2" Grid.Column="1"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,5"/>

                            <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" Background="#F1F5F9" Margin="0,0,0,5"/>

                            <!-- Generated By -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#x1F464;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generated by" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGeneratedBy" Grid.Row="4" Grid.Column="1"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Reason Field (optional comment) -->
                    <StackPanel Margin="0,0,0,8">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Reason" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text="Optional" FontSize="9" Foreground="#94A3B8"
                                       HorizontalAlignment="Right" FontStyle="Italic"/>
                        </Grid>
                        <TextBox x:Name="ReasonTextBox"
                                 MinHeight="38" MaxHeight="58"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6,5" FontSize="10"
                                 BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Copied Confirmation (hidden by default) -->
                    <Border x:Name="CopiedBanner" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#x2705;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OTP code copied to clipboard" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#15803D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- OK and Cancel Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="2" Content="OK" Click="OK_Click"
                            Style="{StaticResource PrimaryButton}" Width="80"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

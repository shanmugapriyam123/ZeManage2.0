<Window x:Class="BIManageRevit.BIManage.Views.Bindings.UnpinAuthorizationDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pin Protection"
        Width="600"
        Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BIManageRevit;component/BIManage/Views/styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Standard title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title with Icon -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#FFF3E0" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                        <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="Protected Element - Authorization Required"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <!-- Alert Banner -->
                    <Border Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource DialogInstruction}" Margin="0">
                                <Run Text="Cannot " FontWeight="SemiBold"/>
                                <Run x:Name="AlertCommandName" Text="unpin" FontWeight="Bold" Foreground="#E65100"/>
                                <Run Text=" " FontWeight="SemiBold"/>
                                <Run Text="{Binding ElementCount, Mode=OneWay}" FontWeight="Bold" Foreground="#E65100"/>
                                <Run Text=" protected element(s)" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Command Name -->
                    <Border x:Name="CommandNameSection" Background="White" CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                            BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Command" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBlock x:Name="CommandNameText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1E293B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Screenshot Preview (only shown when image is available) -->
                    <Border Margin="0,0,0,12" CornerRadius="6"
                            BorderBrush="#D6DCE5" BorderThickness="1"
                            Background="White"
                            x:Name="ImageSection"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.05"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Preview"
                                       FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="#5A6A7E" Margin="10,8,10,5"/>
                            <Border BorderBrush="#E8ECF1" BorderThickness="1"
                                    Margin="10,0,10,10" CornerRadius="6" Height="130"
                                    Background="#F5F7FA">
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform" Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Comment Field (Required) -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Comment" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text=" *" FontSize="10" FontWeight="Bold" Foreground="#EF5350"/>
                        </StackPanel>
                        <TextBox x:Name="CommentTextBox"
                                 MinHeight="48" MaxHeight="64"
                                 TextWrapping="Wrap" AcceptsReturn="False"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6" FontSize="10.5"
                                 BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                                 TextChanged="CommentTextBox_TextChanged"
                                 KeyDown="CommentTextBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock x:Name="CommentValidation" Text="Comment is required"
                                   FontSize="9" Foreground="#EF5350" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Protected Pin Mode Info -->
                    <Border x:Name="PinModeSection" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#E65100" FontSize="11">
                                <Run x:Name="PinModeLabel" Text="Protected Pin Mode: "/><Run x:Name="PinModeText" Text="Unpin"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#5D4037" Margin="0,4,0,0" TextWrapping="Wrap">
                                These elements are protected. Contact your BIM administrator.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Command Link Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="center">
                        <Button x:Name="EnterOtpButton" Click="EnterOtpButton_Click"
                                Style="{StaticResource CommandLinkButton}" Width="133" Height="42"
                                IsEnabled="False">
                            <TextBlock Text="Enter OTP Code"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#000000" Width="102"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

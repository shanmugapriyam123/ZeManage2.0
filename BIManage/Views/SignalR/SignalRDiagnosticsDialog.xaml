<Window x:Class="BIManageRevit.BIManage.Views.SignalR.SignalRDiagnosticsDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage - SignalR Diagnostics"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_KeyDown"
        Closed="Window_Closed">

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Existing content -->
            <StackPanel Grid.Row="1" Margin="28,24">
                <!-- Status Indicator -->
                <Border x:Name="StatusCircle" Width="56" Height="56" CornerRadius="28"
                        HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock x:Name="StatusIcon" FontSize="26" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Connection Info Card -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="16,14" Margin="0,0,0,12"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <!-- Connection State -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="State" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="StateText" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E293B"/>
                        </Grid>

                        <!-- Connection ID -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connection ID" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="ConnectionIdText" Grid.Column="1" FontSize="9" Foreground="#475569"
                                       FontFamily="Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Hub URL -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hub URL" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="HubUrlText" Grid.Column="1" FontSize="9" Foreground="#475569"
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Last Connected -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last Connected" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="LastConnectedText" Grid.Column="1" FontSize="10" Foreground="#475569"/>
                        </Grid>

                        <!-- Reconnect Attempts -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Reconnect Attempts" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="ReconnectAttemptsText" Grid.Column="1" FontSize="10" Foreground="#475569"/>
                        </Grid>

                        <!-- Rate Limit Status -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rate Limited" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="RateLimitText" Grid.Column="1" FontSize="10" Foreground="#475569"/>
                        </Grid>

                        <!-- Active Groups -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Active Groups" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Top"/>
                            <TextBlock x:Name="ActiveGroupsText" Grid.Column="1" FontSize="9" Foreground="#475569"
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Listener Count -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Listeners" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="ListenerCountText" Grid.Column="1" FontSize="10" Foreground="#475569"/>
                        </Grid>

                        <!-- Last Error -->
                        <Grid x:Name="ErrorRow" Margin="0,0,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last Error" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Top"/>
                            <TextBlock x:Name="LastErrorText" Grid.Column="1" FontSize="9" Foreground="#EF4444"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="TestConnectionBtn" Content="Test Connection" Click="TestConnection_Click"
                            Padding="16,0" Height="36" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#FF5500" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#E5611A"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="ForceReconnectBtn" Content="Force Reconnect" Click="ForceReconnect_Click"
                            Padding="16,0" Height="36" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"
                            BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="#212121"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="CopyDiagnosticsBtn" Content="Copy Info" Click="CopyDiagnostics_Click"
                            Padding="16,0" Height="36" FontSize="11" FontWeight="SemiBold"
                            BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="#212121"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#F5F5F5"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Status message -->
                <TextBlock x:Name="ActionStatusText" FontSize="10" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="BIManageRevit.BIManage.Views.Rules.RulesManagementDialog"
        Topmost="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BIManageRevit.BIManage.Views.Rules"
        Title="Rule Management"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>
    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="NotifyBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AssistOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="ProtectRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>

        <!-- Gradient Primary Button -->
        <Style x:Key="PrimaryGradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="#FF5500">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5611A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White Secondary Button -->
        <Style x:Key="WhiteButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5500"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5500"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Icon Button -->
        <Style x:Key="DeleteIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="40"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <!-- Word-wrap so two-word headers render as two stacked lines
                                 (Req / Comment, Capture / Before, Send / Email, Admin /
                                 Override). MinWidth on columns + DataGrid horizontal
                                 scrollbar prevents letter-stacking when the panel squeezes. -->
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="Center"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- White Filter ComboBox Style -->
        <Style x:Key="WhiteFilterComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#64748B" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Converters -->
        <local:ModeToBrushConverter x:Key="ModeToBrushConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolToIconConverter x:Key="BoolToIconConverter"/>
        <local:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
    </Window.Resources>

    <Border Margin="10" Background="White" CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"
                               Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" Width="28" Height="28"
                            BorderThickness="0" Background="Transparent" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search & Filters (Left Side) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="6" Padding="10,0" Height="32" Width="280">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.5"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="11"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Search rules..." Foreground="#94A3B8" FontSize="11"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <ComboBox x:Name="StatusFilter" Width="100" Margin="10,0,0,0"
                              Style="{StaticResource WhiteFilterComboBox}"
                              SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBoxItem Content="All Status" IsSelected="True" Tag=""/>
                        <ComboBoxItem Content="Active" Tag="Active"/>
                        <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                    </ComboBox>

                    <ComboBox x:Name="ModeFilter" Width="100" Margin="10,0,0,0"
                              Style="{StaticResource WhiteFilterComboBox}"
                              SelectionChanged="ModeFilter_SelectionChanged">
                        <ComboBoxItem Content="All Modes" IsSelected="True" Tag=""/>
                        <ComboBoxItem Content="Notify" Tag="Notify"/>
                        <ComboBoxItem Content="Assist" Tag="Assist"/>
                        <ComboBoxItem Content="Protect" Tag="Protect"/>
                    </ComboBox>
                </StackPanel>

                <!-- Action Buttons (Right Side) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Import" Style="{StaticResource WhiteButton}"
                            Command="{Binding ImportExcelCommand}" Margin="0,0,6,0"/>
                    <Button Content="Export" Style="{StaticResource WhiteButton}"
                            Command="{Binding ExportExcelCommand}" Margin="0,0,6,0"/>
                    <Button Content="Refresh" Style="{StaticResource WhiteButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
                    <Button x:Name="AddNewRuleButton" Content="+ New Rule" Style="{StaticResource PrimaryGradientButton}"
                            Click="AddNewRule_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <Border Grid.Column="0" Background="White" CornerRadius="6"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <DataGrid x:Name="RulesDataGrid"
                              ItemsSource="{Binding FilteredRules}"
                              SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              CanUserResizeColumns="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              AllowDrop="True"
                              SelectionChanged="DataGrid_SelectionChanged"
                              PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="DataGrid_PreviewMouseMove"
                              Drop="DataGrid_Drop"
                              DragOver="DataGrid_DragOver">
                        <DataGrid.Columns>

                            <!-- Drag Handle (First Column) -->
                            <DataGridTemplateColumn Header="" Width="22">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="&#x2630;" FontSize="11" Foreground="#CBD5E1"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Cursor="SizeAll" ToolTip="Drag to reorder rows"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- S.No Column -->
                            <DataGridTemplateColumn Header="S.No" Width="50" MinWidth="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RowNumber}" FontSize="11" FontWeight="Medium"
                                                   Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="Serial Number"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Toggle Column (Compact) — hidden for Company/Project admins in code-behind OnLoaded -->
                            <DataGridTemplateColumn x:Name="StatusToggleColumn" Header="Status" Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="StatusToggle_Click" Cursor="Hand"
                                                ToolTip="{Binding StatusTooltip}" HorizontalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="32" Height="16">
                                                        <!-- Toggle Track -->
                                                        <Border x:Name="track" CornerRadius="8"
                                                                Background="{Binding IsEnabled, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=toggleBg}"/>
                                                        <!-- Toggle Thumb -->
                                                        <Border x:Name="thumb" Width="12" Height="12" CornerRadius="6"
                                                                Background="White" VerticalAlignment="Center"
                                                                HorizontalAlignment="{Binding IsEnabled, Converter={StaticResource BoolToAlignmentConverter}}"
                                                                Margin="2,0">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.15"/>
                                                            </Border.Effect>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category Name (First Column) -->
                            <DataGridTemplateColumn Header="Category" Width="2*" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="Medium"
                                                   Foreground="#1E293B" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RuleNameTooltip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Command Name with Name Tooltip -->
                            <DataGridTemplateColumn Header="Command Name" Width="1.5*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CommandName}" FontSize="11"
                                                   Foreground="#64748B" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CommandNameTooltip}"
                                                   ToolTipService.ShowDuration="20000"
                                                   ToolTipService.InitialShowDelay="300"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Mode Badge - Light Colors -->
                            <DataGridTemplateColumn Header="Mode" Width="65" MinWidth="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Mode, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=light}"
                                                CornerRadius="10" Padding="6,3" HorizontalAlignment="Center"
                                                ToolTip="{Binding ModeTooltip}">
                                            <TextBlock Text="{Binding ModeDisplayNew}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{Binding Mode, Converter={StaticResource ModeToBrushConverter}}" TextAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rule Scope with Name Tooltip -->
                            <DataGridTemplateColumn Header="Scope" Width="1*" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RuleScopeDisplay}" FontSize="11"
                                                   Foreground="#64748B" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RuleScopeDisplay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Require Comment -->
                            <DataGridTemplateColumn Header="Req Comment" Width="75" MinWidth="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding RequireComment, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radio}"
                                                 Stroke="{Binding RequireComment, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radioStroke}"
                                                 StrokeThickness="1"
                                                 ToolTip="Requires user to provide a comment"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Capture Before Screenshot -->
                            <DataGridTemplateColumn Header="Capture Before" Width="75" MinWidth="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding CaptureBeforeScreenshot, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radio}"
                                                 Stroke="{Binding CaptureBeforeScreenshot, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radioStroke}"
                                                 StrokeThickness="1"
                                                 ToolTip="Capture screenshot before command execution"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Capture After Screenshot -->
                            <DataGridTemplateColumn Header="Capture After" Width="75" MinWidth="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding CaptureAfterScreenshot, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radio}"
                                                 Stroke="{Binding CaptureAfterScreenshot, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radioStroke}"
                                                 StrokeThickness="1"
                                                 ToolTip="Capture screenshot after command execution"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Notify by Email -->
                            <DataGridTemplateColumn Header="Notify by Email" Width="65" MinWidth="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding SendEmail, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radio}"
                                                 Stroke="{Binding SendEmail, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radioStroke}"
                                                 StrokeThickness="1"
                                                 ToolTip="Send email notification when triggered"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Admin Override -->
                            <DataGridTemplateColumn Header="Admin Override" Width="80" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{Binding AllowAdminOverride, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radio}"
                                                 Stroke="{Binding AllowAdminOverride, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=radioStroke}"
                                                 StrokeThickness="1"
                                                 ToolTip="Allows admin to override this rule"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Modified By with Full Tooltip -->
                            <DataGridTemplateColumn Header="Modified By" Width="1*" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedBy}" FontSize="11"
                                                   Foreground="#94A3B8" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullDataTooltip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" ToolTip="Edit Rule"
                                                    Click="EditButton_Click">
                                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                      Fill="#3B82F6" Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                            <Button ToolTip="Delete Rule"
                                                    Click="DeleteButton_Click" Margin="2,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DeleteIconButton}">
                                                        <!-- Hide the delete icon for Company-scope rows ONLY when
                                                             the current user is NOT a Company Admin (Project Admin
                                                             logged in). Company Admins always see the delete button.
                                                             IsCompanyAdmin lives on RulesManagementViewModel —
                                                             reached via RelativeSource AncestorType=Window. -->
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RuleScopeDisplay}" Value="Company"/>
                                                                    <Condition Binding="{Binding DataContext.IsCompanyAdmin, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                      Fill="#EF4444" Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading Overlay -->
                    <Border Background="#E0FFFFFF" CornerRadius="6"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Loading..." FontSize="14" FontWeight="Medium" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Edit Panel -->
            <Border x:Name="EditPanel" Grid.Column="1" MinWidth="270" MaxWidth="350" Background="White" CornerRadius="6"
                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="8,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Edit Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="6,6,0,0" Padding="12,8">
                        <Grid>
                            <TextBlock x:Name="EditPanelTitle" Text="Edit Rule" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseEditPanel_Click"
                                    Width="20" Height="20">
                                <TextBlock Text="&#x2715;" FontSize="10" Foreground="#64748B"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Edit Form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <StackPanel x:Name="EditForm">
                            <!-- Category (Searchable Dropdown for new, ReadOnly for edit) -->
                            <TextBlock Text="Category" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="EditCategoryReadOnly" Height="30" FontSize="11" Padding="8,5" Margin="0,0,0,2"
                                     BorderBrush="#E2E8F0" BorderThickness="1" IsReadOnly="True" Background="#F9FAFB" Visibility="Collapsed"/>
                            <Border x:Name="CategoryDropdownBorder" Height="30" Background="White"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CategoryDisplayText" Grid.Column="0" Text="Select category..."
                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"
                                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#64748B" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ToggleButton x:Name="CategoryDropdownToggle" Grid.ColumnSpan="2"
                                                  Checked="CategoryDropdown_Checked" Unchecked="CategoryDropdown_Unchecked">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup x:Name="CategoryPopup" PlacementTarget="{Binding ElementName=CategoryDropdownBorder}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding IsChecked, ElementName=CategoryDropdownToggle}">
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="6" Margin="0,2,0,0" MinWidth="250" MaxHeight="400">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <!-- Search Box -->
                                                <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBox x:Name="CategorySearchBox" FontSize="11"
                                                             BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,4"
                                                             TextChanged="CategorySearchBox_TextChanged">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                                    <VisualBrush.Visual>
                                                                                        <TextBlock Text="Search categories..." Foreground="#94A3B8" FontSize="11" Margin="6,0,0,0"/>
                                                                                    </VisualBrush.Visual>
                                                                                </VisualBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="330" Padding="4">
                                                    <ItemsControl x:Name="CategoryList" ItemsSource="{Binding FilteredCategories}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="catItemBorder" Background="Transparent" Padding="8,6" Cursor="Hand"
                                                                        MouseLeftButtonUp="CategoryItem_Click">
                                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#1E293B"/>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="catItemBorder" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="catItemBorder" Property="Background" Value="#F5F5F5"/>
                                                                    </Trigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <!-- Hidden ComboBox for backward compatibility -->
                            <ComboBox x:Name="EditCategoryCombo" Visibility="Collapsed"/>
                            <TextBlock x:Name="EditCategoryError" Text="Please select a category" FontSize="9"
                                       Foreground="#EF4444" Margin="0,0,0,4" Visibility="Collapsed"/>
                            <!-- Command (Multi-Select Dropdown) -->
                            <TextBlock Text="Command" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <Border x:Name="CommandDropdownBorder" Height="30" Background="White"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CommandDisplayText" Grid.Column="0" Text="Select commands..."
                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"
                                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#64748B" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ToggleButton x:Name="CommandDropdownToggle" Grid.ColumnSpan="2"
                                                  Checked="CommandDropdown_Checked" Unchecked="CommandDropdown_Unchecked">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup x:Name="CommandPopup" PlacementTarget="{Binding ElementName=CommandDropdownBorder}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding IsChecked, ElementName=CommandDropdownToggle}">
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="6" Margin="0,2,0,0" MinWidth="250" MaxHeight="400">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <!-- Search Box -->
                                                <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBox x:Name="CommandSearchBox" FontSize="11"
                                                             BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,4"
                                                             TextChanged="CommandSearchBox_TextChanged">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                                    <VisualBrush.Visual>
                                                                                        <TextBlock Text="Search commands..." Foreground="#94A3B8" FontSize="11" Margin="6,0,0,0"/>
                                                                                    </VisualBrush.Visual>
                                                                                </VisualBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="330" Padding="4">
                                                    <ItemsControl x:Name="CommandCheckList" ItemsSource="{Binding FilteredCommands}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding CommandName}" FontSize="10" Margin="4,3"
                                                                          ToolTip="{Binding Description}"
                                                                          ToolTipService.ShowDuration="20000"
                                                                          ToolTipService.InitialShowDelay="300"
                                                                          Checked="CommandCheckBox_Changed" Unchecked="CommandCheckBox_Changed"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="EditCommandError" Text="Please select at least one command" FontSize="9"
                                       Foreground="#EF4444" Margin="0,0,0,4" Visibility="Collapsed"/>
                            <!-- Hidden TextBox for backward compatibility -->
                            <TextBox x:Name="EditCommandName" Visibility="Collapsed"/>
                            <!-- Hidden ComboBox for backward compatibility -->
                            <ComboBox x:Name="EditCommandDropdown" Visibility="Collapsed"/>

                            <!-- Hidden Description for backward compatibility -->
                            <TextBox x:Name="EditDescription" Visibility="Collapsed"/>

                            <!-- Message -->
                            <TextBlock Text="Message" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="EditMessage" Height="45" FontSize="11" Padding="8,5" Margin="0,0,0,10"
                                     BorderBrush="#E2E8F0" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True"/>

                            <!-- Mode -->
                            <TextBlock Text="Mode" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox x:Name="EditMode" Height="30" FontSize="11" Padding="8,5" Margin="0,0,0,10"
                                      BorderBrush="#E2E8F0" BorderThickness="1">
                                <ComboBoxItem Content="Notify" Tag="Notify"/>
                                <ComboBoxItem Content="Assist" Tag="Assist"/>
                                <ComboBoxItem Content="Protect" Tag="Protect"/>
                            </ComboBox>

                            <!-- Category -->
                           

                            <!-- Rule Scope -->
                            <TextBlock Text="Rule Scope" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox x:Name="EditRuleScope" Height="30" FontSize="11" Padding="8,5" Margin="0,0,0,10"
                                      BorderBrush="#E2E8F0" BorderThickness="1"
                                      SelectionChanged="EditRuleScope_SelectionChanged">
                                <ComboBoxItem Content="Company" Tag="1"/>
                                <ComboBoxItem Content="Project" Tag="2"/>
                                <ComboBoxItem Content="Model" Tag="3"/>
                            </ComboBox>

                            <!-- Hidden panels kept for code-behind compatibility -->
                            <StackPanel x:Name="ProjectSelectionPanel" Visibility="Collapsed">
                                <ComboBox x:Name="EditProjectCombo" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel x:Name="ModelSelectionPanel" Visibility="Collapsed">
                                <ComboBox x:Name="EditModelCombo" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Checkboxes -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Require Comment is disabled when Mode = Notify, since Notify mode does not
                                         show a dialog and therefore has no opportunity to collect a user comment. -->
                                    <CheckBox x:Name="EditRequireComment" Content="Require Comment" FontSize="10" Margin="0,0,0,6">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=EditMode, Path=SelectedItem.Tag}" Value="Notify">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="IsChecked" Value="False"/>
                                                        <Setter Property="ToolTip" Value="Notify mode does not show a dialog, so a comment cannot be collected."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <CheckBox x:Name="EditCaptureBeforeScreenshot" Content="Capture Before Screenshot" FontSize="10" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="EditCaptureAfterScreenshot" Content="Capture After Screenshot" FontSize="10" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="EditSendEmail" Content="Notify by Email" FontSize="10" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="EditAllowAdminOverride" Content="Allow Admin Override" FontSize="10" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Edit Actions -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,6,6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource WhiteButton}" Width="65" Height="28"
                                    Click="CancelEdit_Click"/>
                            <Button Content="Save" Style="{StaticResource PrimaryGradientButton}" Width="65" Height="28" Margin="6,0,0,0"
                                    Click="SaveEdit_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0" Padding="16,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#22C55E" FontWeight="SemiBold" FontSize="10" Margin="0,0,12,0"/>
                    <TextBlock Foreground="#94A3B8" FontSize="10">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} rules">
                                <Binding Path="FilteredRules.Count" Mode="OneWay"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#22C55E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="False">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="&#x25CF; {0}">
                            <Binding Path="DatabaseStatusText" Mode="OneWay"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Delete Confirmation Popup -->
        <Border x:Name="DeletePopup" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="10" Width="340" Height="170"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                </Border.Effect>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Background="#FEE2E2" CornerRadius="14" Width="28" Height="28">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Fill="#EF4444" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Delete Rule" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Are you sure you want to delete this rule?" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DeleteRuleName" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,5,0,0"/>
                        <TextBlock Text="This action cannot be undone." FontSize="9" Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource WhiteButton}" Width="70" Height="30"
                                Click="CancelDelete_Click"/>
                        <Button Content="Delete" Width="70" Margin="8,0,0,0" Height="30"
                                Click="ConfirmDelete_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="#EF4444" CornerRadius="6" Padding="10,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Foreground>
                                <SolidColorBrush Color="White"/>
                            </Button.Foreground>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Success Popup (Toast) -->
        <Border x:Name="SuccessPopup" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,20,0,0" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" MinWidth="280" MaxWidth="400"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Success Icon -->
                    <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#22C55E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Message -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SuccessTitle" Text="Success" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock x:Name="SuccessMessage" Text="Operation completed" FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Click="CloseSuccessPopup_Click" Cursor="Hand" Margin="10,0,0,0"
                            Width="24" Height="24" VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12">
                                    <TextBlock Text="×" FontSize="16" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Border>
        </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="BIManageRevit.BIManage.Views.Rules.RulesManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BIManageRevit.BIManage.Views.Rules"
        Title="Rule Management"
        Width="1399"
        Height="977"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/BIManageRevit;component/BIManage/Resources/Icons/BIManage.png"/>
    </Window.Icon>
    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#002a54"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#050708"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FAFAFA"/>

        <!-- Gradient Button Style (Primary) -->
        <Style x:Key="GradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#002a54" Offset="0"/>
                                    <GradientStop Color="#003d7a" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#050708" Offset="0"/>
                                            <GradientStop Color="#0d0d0e" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#F44336" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#003d7a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Converters -->
        <local:ModeToBrushConverter x:Key="ModeToBrushConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rule Management" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="#E8EEF5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Import/Export Group - Enhanced -->
                    <Border BorderBrush="White" BorderThickness="2"
                            CornerRadius="6" Padding="6" Margin="0,0,12,0"
                            Background="White" Width="377">
                        <Border.Effect>
                            <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📥 Import JSON" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ImportExcelCommand}" Margin="0"
                                    Width="176" Height="54" FontWeight="SemiBold">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel Width="300">
                                            <TextBlock Text="Import Rules from JSON" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <TextBlock Text="• Automatically loads rules from JSON file" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Data is inserted directly into database" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Categories are matched automatically" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Click to select your JSON file" TextWrapping="Wrap" FontStyle="Italic" Foreground="#4CAF50"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                            <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,6"/>
                            <Button Content="📤 Export JSON" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ExportExcelCommand}" Margin="0"
                                    Width="172" Height="49" FontWeight="SemiBold">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel Width="300">
                                            <TextBlock Text="Export Rules to JSON" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <TextBlock Text="• Saves all rules to JSON file" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Perfect for backup and sharing" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Can be imported on other systems" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Content="🔄 Refresh" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                            ToolTip="Refresh the rules list from database"
                            Height="51" Width="138"/>
                    <Button Content="➕ Add Rule" Style="{StaticResource GradientButton}"
                            Command="{Binding AddRuleCommand}" IsEnabled="{Binding IsNotEditing}"
                            ToolTip="Create a new protection rule"
                            Height="36"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content - Full Width Table -->
        <Border Grid.Row="1" Margin="24,16" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Table Header with Actions -->
                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Rules Overview" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="✏️ Edit" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding EditRuleCommand}"
                                    Width="90" Height="32" Margin="0,0,8,0"
                                    ToolTip="Edit selected rule"/>
                            <Button Content="🗑️ Delete" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteRuleCommand}"
                                    Width="90" Height="32"
                                    Click="DeleteButton_Click"
                                    ToolTip="Delete selected rule"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid with Scroll -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding Rules}"
                              SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                              BorderThickness="0"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <!-- Priority with visual indicator -->
                            <DataGridTemplateColumn Header="⭐ Priority" Width="80" SortMemberPath="Priority">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF3E0" CornerRadius="3" Padding="8,4" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Priority}" FontSize="12" FontWeight="Bold" Foreground="#E65100"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="80" SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsEnabled, Converter={StaticResource ModeToBrushConverter}, ConverterParameter=status}"
                                                CornerRadius="3" Padding="6,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="Medium" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rule Name -->
                            <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Description -->
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Mode -->
                            <DataGridTemplateColumn Header="Mode" Width="90" SortMemberPath="Mode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Mode, Converter={StaticResource ModeToBrushConverter}}"
                                                CornerRadius="3" Padding="6,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ModeDisplay}" FontSize="10" FontWeight="Medium" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category Name -->
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/>

                            <!-- Category Code -->
                            <DataGridTextColumn Header="Category Code" Binding="{Binding CategoryCode}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Message -->
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="#555"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Capture Before -->
                            <DataGridTemplateColumn Header="📷 Before" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CaptureBeforeDisplay}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="Capture Before Screenshot"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Capture After -->
                            <DataGridTemplateColumn Header="📷 After" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CaptureAfterDisplay}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="Capture After Screenshot"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Require Comment -->
                            <DataGridTemplateColumn Header="💬 Comment" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RequireCommentDisplay}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="Require Comment"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Allow Admin Override -->
                            <DataGridTemplateColumn Header="🔓 Override" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AllowOverrideDisplay}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="Allow Admin Override"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rule Scope -->
                            <DataGridTemplateColumn Header="Scope" Width="110" SortMemberPath="RuleScope">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E3F2FD" CornerRadius="3" Padding="6,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding RuleScope}" FontSize="9" Foreground="#1976D2" FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Model GUID (truncated) -->
                            <DataGridTextColumn Header="Model GUID" Binding="{Binding ModelGuidShort}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="9"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="#999"/>
                                        <Setter Property="ToolTip" Value="{Binding ModelGuid}"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Modified By -->
                            <DataGridTextColumn Header="Modified By" Binding="{Binding ModifiedBy}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Modified At -->
                            <DataGridTextColumn Header="Modified On" Binding="{Binding ModifiedAt}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Table Footer with Item Count -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                    <TextBlock>
                        <Run Text="Total Rules: "/>
                        <Run Text="{Binding Rules.Count, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" | Selected: "/>
                        <Run Text="{Binding SelectedRule.Name, Mode=OneWay, FallbackValue='None'}" FontWeight="Medium"/>
                    </TextBlock>
                </Border>

                <!-- Loading Overlay -->
                <Border Grid.RowSpan="3" Background="#80FFFFFF"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔄 Loading..." FontSize="16" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <Button Grid.Column="1" Content="Close" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CloseCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

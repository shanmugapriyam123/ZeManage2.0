<Project Sdk="Microsoft.NET.Sdk">

    <!--
        BIManageRevit.Shim — a tiny IExternalApplication forwarder.

        Purpose:
          On Revit 2025 (.NET 8), Revit's manifest scanner loads the .addin <Assembly>
          into the Default AssemblyLoadContext, and the add-in instantiator loads it
          AGAIN into a custom collectible ALC. Two copies of the same simple-named
          assembly are then live in the AppDomain. When command bindings (Pin/Unpin/
          Move/Rotate/Mirror/CommandProtectionBinding etc.) are registered from one
          copy, Revit's native AddInManager::commandHasAddinSubscriptions walks the
          binding table, cannot deterministically resolve the "host add-in" for the
          handler, and throws — surfacing as the native "Revit encountered a serious
          error" dialog that takes the user's unsaved work down with it.

          R26 has <UseRevitContext>True</UseRevitContext> in the manifest schema which
          eliminates the dual-load. R25's schema rejects that element (verified against
          AddInManager.dll string tables) so the same fix is unavailable there.

          This Shim is the alternative: BIManageRevit.addin points to BIManageRevit.Shim.dll
          (not BIManageRevit.dll). Revit's scanner therefore only ever encounters the Shim
          DLL — which has NO command bindings, NO Revit-API event subscriptions, NO WPF
          dialogs, NO singletons. A dual-load of the Shim itself is harmless because there
          are no subscriptions for AddInManager to mis-attribute.

          The Shim's OnStartup loads BIManageRevit.dll (the Core, unchanged) into a
          dedicated AssemblyLoadContext named "BIManageRevit", instantiates the Core's
          existing `BIManageRevit.BIManage.Revit.Applications.Application` class via
          reflection, and forwards `IExternalApplication.OnStartup`/`OnShutdown` to it.
          Because the Core is loaded only via this code path, Revit's manifest scanner
          never sees it and no duplicate-load is created.

        Why this is safe (zero behavior change for Core code):
          - All 63 WPF pack URIs continue to read `;component/BIManageRevit;` — they refer
            to the Core assembly's short name, which is unchanged (still "BIManageRevit").
          - `Application.ResourceAssembly = typeof(Application).Assembly` (Application.cs:284)
            naturally points at the Core copy in the custom ALC.
          - CrossAlcDispatch's name-based matching (Common/Helpers/CrossAlcDispatch.cs)
            uses `GetName().Name` dynamically and works regardless of which ALC the calling
            command Execute lands in.
          - The Core's existing static-ctor guard (Application.cs:48-87) becomes belt-and-
            braces but is no longer load-bearing — the Core no longer loads into Default ALC
            at all.

        Why the Shim doesn't trip the same crash class:
          - The Shim has no `ControlledApplication.DocumentOpened` / `DocumentChanged` /
            `Idling` subscriptions.
          - The Shim registers no `AddInCommandBinding` handlers.
          - When Revit's native scan walks "who is the host of these subscriptions?", every
            subscription was made via the Core's `Application.OnStartup` running through
            `IExternalApplication.OnStartup(application)` called by the Shim on the Revit
            UI thread, i.e. inside the call frame that has the Shim's add-in ID as the
            active context. Revit attributes the subscription to the Shim (the listed
            add-in), which is found by AddInManager and resolves cleanly.
    -->

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Platforms>AnyCPU;x64</Platforms>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <PlatformTarget>x64</PlatformTarget>
        <Nullable Condition="'$(TargetFramework)' == 'net48'">disable</Nullable>
        <Nullable Condition="'$(TargetFramework)' != 'net48'">enable</Nullable>

        <!--
            EnableDynamicLoading=true emits BIManageRevit.Shim.runtimeconfig.json + deps.json
            next to the Shim DLL. On Revit 2025+ this signals Revit to set up an ALC for
            the Shim; without it Revit 2025 falls back to a fragmented load. Even though
            the Shim itself is dual-load-safe (no subscriptions), keeping it true matches
            how the Core has always shipped and avoids surprises during cross-version test.
            No-op on net48 (Revit 2021-2024).
        -->
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <!-- Pin AssemblyVersion stable for the same reason as the Core: WPF BAML pack URIs
             bake AssemblyVersion in. The Shim has no XAML so this is purely defensive. -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>0.7.6.0</FileVersion>
        <InformationalVersion>0.7.6</InformationalVersion>

        <Configurations>Debug R21;Debug R22;Debug R23;Debug R24;Debug R25;Debug R26;Debug R27</Configurations>
        <Configurations>$(Configurations);Release R21;Release R22;Release R23;Release R24;Release R25;Release R26;Release R27</Configurations>

        <!-- Same noisy-attribute suppressions as the Core, for consistency. -->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
        <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
        <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
        <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
        <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
        <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
        <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>

        <!-- Stop the SDK from scanning sibling project folders. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Revit configuration — mirror the Core's TFM matrix exactly so a single
         "Debug R25" build produces both the Core and the Shim against the same
         Revit API version. -->
    <PropertyGroup Condition="$(Configuration.Contains('R21'))">
        <RevitVersion>2021</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2021;REVIT2021_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R22'))">
        <RevitVersion>2022</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2022;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R23'))">
        <RevitVersion>2023</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2023;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R24'))">
        <RevitVersion>2024</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2024;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R25'))">
        <RevitVersion>2025</RevitVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <DefineConstants>REVIT2025;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
        <RevitVersion>2026</RevitVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <DefineConstants>REVIT2026;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R27'))">
        <RevitVersion>2027</RevitVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
        <DefineConstants>REVIT2027;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER;REVIT2027_OR_GREATER</DefineConstants>
    </PropertyGroup>

    <!-- Fallback: same as the Core, default to Revit 2024 (net48) for this machine. -->
    <PropertyGroup Condition="'$(TargetFramework)' == ''">
        <TargetFramework>net48</TargetFramework>
        <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
        <DefineConstants Condition="'$(RevitVersion)' == '2024'">$(DefineConstants);REVIT2024;REVIT2024_OR_GREATER</DefineConstants>
        <DefineConstants Condition="'$(RevitVersion)' != '2024'">$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    </PropertyGroup>

    <!-- Revit API references only — IExternalApplication + UIControlledApplication.
         These are SHARED types loaded into the Default ALC by Revit itself; both the
         Shim and the Core see the same type identity so the cast across the ALC
         boundary in ShimApplication.cs is type-safe. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.0.*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.0.*" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).0.*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).0.*" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).0.*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).0.*" />
    </ItemGroup>

    <!-- Build outputs go under the Shim's own bin/. The Core's csproj has a copy-step
         (target ShipShim) that pulls Shim outputs into the Core's $(OutputPath) so a
         single Core build produces a fully-deployed addin folder. -->

</Project>

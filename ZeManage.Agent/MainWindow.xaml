<Window x:Class="ZeManage.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage Agent" Width="460" Height="430"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonUp="AgentStatusBanner_Click" ToolTip="Click to retry sync">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#888888" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel" Text="Connecting" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="24,22,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Profile -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBrush}">
                    <TextBlock x:Name="InitialsText" FontSize="18" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MachineText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="TODAY" Foreground="{StaticResource MutedBrush}" FontSize="10"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>

            <!-- Total work time — headline stat -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Total Work Time" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TotalWorkText" Text="0m" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Stat cards -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ActiveText" Text="0m" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Productive" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="IdleText" Text="0m" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Idle" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="BreakText" Text="0m" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Break" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

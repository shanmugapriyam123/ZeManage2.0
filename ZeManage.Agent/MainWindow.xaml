<Window x:Class="ZeManage.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeManage Agent" Height="640" Width="980"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="ZeManage" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text=" Agent 2.0" FontSize="26" FontWeight="Light"/>
            <TextBlock x:Name="VersionText" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="USER" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="UserText" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="MACHINE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="MachineText" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="AGENT ID" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="AgentIdText" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3">
                    <TextBlock Text="OS" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="OsText" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,0,0">
                    <TextBlock Text="CPU: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="CpuModelText" Text="--" FontSize="11" FontWeight="SemiBold" Margin="0,0,24,0"/>
                    <TextBlock Text="RAM: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="TotalRamText" Text="--" FontSize="11" FontWeight="SemiBold" Margin="0,0,24,0"/>
                    <TextBlock Text="IP: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="IpText" Text="--" FontSize="11" FontWeight="SemiBold" Margin="0,0,24,0"/>
                    <TextBlock Text="MAC: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="MacText" Text="--" FontSize="11" FontWeight="SemiBold" Margin="0,0,24,0"/>
                    <TextBlock Text="SID: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="SidText" Text="--" FontSize="11" FontWeight="SemiBold"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="ATTENDANCE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="Today's Session" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Active" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="ActiveText" Text="0m" FontSize="20" FontWeight="Bold" Foreground="{StaticResource OkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Idle" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="IdleText" Text="0m" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Login" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="LoginText" Text="--:--" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                <StackPanel>
                    <TextBlock Text="SYNC STATUS" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="SyncStatusText" Text="Never" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Last Sync" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="LastSyncText" Text="Never" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Unsynced Rows" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="UnsyncedText" Text="0" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hub" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="HubStatusText" Text="--" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="HARDWARE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="Latest Snapshot" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="CpuText" Text="--%" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RAM" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="RamText" Text="--%" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GPU" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="GpuText" Text="--%" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Disk" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="DiskText" Text="--%" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                <StackPanel>
                    <TextBlock Text="NETWORK" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="Connectivity Health" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Latency" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="LatencyText" Text="-- ms" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Loss" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="LossText" Text="--%" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Health" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="HealthText" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource OkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="VPN" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="VpnText" Text="--" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="BROWSER TRACKING" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="Active Browser Session" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="BROWSER" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="BrowserNameText" Text="--" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CURRENT PAGE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="BrowserTitleText" Text="Not tracking" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="20,0,0,0">
                            <TextBlock Text="SINCE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="BrowserSinceText" Text="--:--" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="20,0,0,0">
                            <TextBlock Text="SCREENSHOTS" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="ScreenshotCountText" Text="0" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="RECENT ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                    <ListBox x:Name="EventsList"
                             Grid.Row="1"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="Conserve Solution  •  AEC Workforce Intelligence Platform" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            <TextBlock x:Name="DbPathText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

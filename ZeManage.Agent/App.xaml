<Application x:Class="ZeManage.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZeManage.Agent"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBrush"  Color="#F8F8F8"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7A00"/>
        <SolidColorBrush x:Key="TextBrush"   Color="#111111"/>
        <SolidColorBrush x:Key="MutedBrush"  Color="#666666"/>
        <SolidColorBrush x:Key="OkBrush"     Color="#16A34A"/>
        <SolidColorBrush x:Key="WarnBrush"   Color="#D97706"/>
        <SolidColorBrush x:Key="ErrBrush"    Color="#DC2626"/>
    </Application.Resources>
</Application>

<Application x:Class="ZeManage.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZeManage.Agent"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="OkBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="ErrBrush" Color="#F87171"/>
    </Application.Resources>
</Application>

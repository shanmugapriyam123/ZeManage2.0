<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWPF>true</UseWPF>
        <Version>1.0.1</Version>
        <!--
            AssemblyVersion is intentionally pinned to 1.0.0.0 (decoupled from product release).
            WPF's MarkupCompiler embeds the AssemblyVersion into the pack URI it generates inside
            BAML / *.g.cs (e.g. `/BIManageRevit;V0.2.2.0;component/...`). When the version is bumped
            but the per-Revit obj/ folder isn't fully regenerated, the BAML keeps the OLD version in
            the URI while the assembly is stamped with the NEW version, and Application.LoadComponent
            throws `IOException: cannot find resource …` at the first XAML window's InitializeComponent
            (this is what the 0.2.3.0 deploy hit on Revit 2025: stale obj/Debug R25/*.g.cs still said
            ;V0.2.2.0; while the assembly itself was 0.2.3.0).
            By pinning AssemblyVersion to 1.0.0.0 we make the pack URI version stable, so future
            product-version bumps never invalidate already-compiled BAML.
            FileVersion + InformationalVersion stay tied to the product release for telemetry / display.
        -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.1.0</FileVersion>
        <InformationalVersion>1.0.1</InformationalVersion>
        <InternalsVisibleTo>BIManageRevit.Tests</InternalsVisibleTo>
        <Nullable Condition="'$(TargetFramework)' == 'net48'">disable</Nullable>
        <Nullable Condition="'$(TargetFramework)' != 'net48'">enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Platforms>AnyCPU;x64</Platforms>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <PlatformTarget>x64</PlatformTarget>
        <ImplicitUsings>true</ImplicitUsings>
        <!--
            EnableDynamicLoading=true is REQUIRED on Revit 2025+ — DO NOT FLIP TO FALSE.
            v0.2.0 (commit 9ac722d, the last verified-working release on R25) had this set to
            true. Every time it has been flipped to false since (commits 50b66ae, and a later
            edit that broke 0.2.5 in the field) the symptom is identical: ribbon loads, but
            every IExternalCommand toasts "Unable to access application services" and WPF
            dialogs throw IOException on InitializeComponent.

            What this property actually does (.NET SDK behaviour for class libraries):
              - true:  emits BIManageRevit.runtimeconfig.json + a fully-populated deps.json
                       next to the DLL. Revit 2025's add-in loader reads runtimeconfig.json to
                       set up ONE coherent per-add-in AssemblyLoadContext. Single ALC, single
                       copy of BIManageRevit, Application.Instance accessible everywhere, WPF
                       pack-URI resolution behaves.
              - false: NO runtimeconfig.json is emitted. Revit 2025 cannot establish a single
                       coherent context, so it falls back to a fragmented load: the manifest
                       scanner loads us into the Default ALC, the instantiator loads us again
                       into an isolation ALC named "BIManageRevit". Two copies of every type,
                       static singletons (Application.Instance) split per ALC, [AsmIdentity]
                       logs "DUPLICATE LOAD DETECTED". Commands dispatched to the wrong copy
                       see null Application.Instance.

            Pair this with <UseRevitContext>True</UseRevitContext> in BIManageRevit.addin —
            BOTH must be set together. Either alone reproduces the duplicate-load symptom.

            No-op on .NET Framework 4.8 (Revit 2021-2024) — that runtime has no
            AssemblyLoadContext concept and ignores EnableDynamicLoading entirely.
        -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <!-- Prevent main project from scanning sub-project directories.
             Bundle\** MUST be excluded: it contains pre-built obfuscator inputs in NuGet-style
             runtimes\<rid>\lib\<tfm>\ layouts. Without exclusion, MSBuild auto-resolves those
             DLLs as RID-specific managed references. For Debug/Release R21-R24 (net48 builds)
             this drags Bundle\...\runtimes\win\lib\net8.0\System.Management.dll into
             @(ReferencePath), and WPF's MarkupCompilePass1 then fails with MC1000
             "Could not find type 'System.Resources.NeutralResourcesLanguageAttribute' in
             assembly System.Runtime.dll" because the .NET 8 ref expects this attribute via
             the System.Runtime contract while net48 has it only in mscorlib / the
             System.Resources.ResourceManager facade. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);BIManage.Addons\**;BIManageRevit.Tests\**;BIManageRevit.Shim\**;Bundle\**;ZeManage.Agent.Core\**;ZeManage.Agent\**;ZeManage.Agent.Check\**;ZeManage.Agent.Watchdog\**;ZeManage.AgentService\**;deploy\**</DefaultItemExcludes>
        <!-- Limit satellite resource assemblies to English only. The transitive Roslyn /
             Microsoft.CodeAnalysis.* packages ship localized error-message resources for
             13 cultures (cs/de/es/fr/it/ja/ko/pl/pt-BR/ru/tr/zh-Hans/zh-Hant), producing
             ~52 *.resources.dll satellite assemblies under <language>\ subfolders in the
             addin deployment. None reach the user: Roslyn errors are caught and surfaced
             via ex.Message in our own UI/logs, which is always English regardless of OS
             locale. The deployed satellites only contribute file-enumeration cost on every
             Revit launch (manifest walk, .NET assembly-resolve probing, AV scan). Setting
             this property to 'en' makes the SDK copy ONLY English satellites (or none if
             none exist), cutting the addin's deployed file count from ~88 to ~36. Files
             are removed; no code or binary changes; Roslyn's resource lookup already falls
             back to English when a culture satellite is missing — which is what en-GB and
             all other non-listed locales experience today anyway. Measured on a customer
             machine where ZeManage was adding 60+ s to Revit cold launch beyond Defender. -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- NuGetAudit: warn about vulnerable packages during restore -->
    </PropertyGroup>

    <!-- Global usings shared across the project (added by UI branch). Keep here so files
         can reference common types without adding explicit using statements. -->
    <ItemGroup>
        <Using Include="Autodesk.Revit.DB" />
        <Using Include="BIManage.Common.Helpers" />
        <Using Include="BIManage.Infrastructure.Api" />
        <Using Include="BIManage.Infrastructure.Logging" />
        <Using Include="BIManage.Core.Protection.Models" />
        <Using Include="BIManage.Revit.Protection" />
    </ItemGroup>

    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <NuGetAuditMode>all</NuGetAuditMode>
        <Configurations>Debug R21;Debug R22;Debug R23;Debug R24;Debug R25;Debug R26;Debug R27</Configurations>
        <Configurations>$(Configurations);Release R21;Release R22;Release R23;Release R24;Release R25;Release R26;Release R27</Configurations>
        <!-- Suppress duplicate assembly attribute generation -->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
        <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
        <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
        <!-- Suppress NeutralResourcesLanguageAttribute auto-generation. Without this, the .NET 10 SDK
             emits the attribute via WPF's MarkupCompilePass1, which then probes the net48 facade
             System.Runtime.dll for the type definition — a probe that fails because the facade is
             empty (the type lives in mscorlib on net48). Setting GenerateNeutralResourcesLanguageAttribute=false
             stops the SDK from inserting the attribute, sidestepping the probe entirely.
             See https://github.com/dotnet/windowsdesktop/issues/3878. -->
        <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
        <!-- Generate the [AssemblyVersion] attribute so the runtime identity matches the
             <AssemblyVersion>1.0.0.0</AssemblyVersion> property AND the ;V1.0.0.0; baked into
             BAML pack URIs by MarkupCompilePass1. With this set to false, runtime identity
             becomes 0.0.0.0 — WPF's pack-URI resolver falls back to simple-name match (which
             usually works) but every other version-aware path in .NET / Revit ends up
             confused. Was set to false in 0.2.5 by mistake; v0.2.0 (verified-working) had it
             defaulting to true. Keep it true. -->
        <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
        <!-- Keep FileVersion + InformationalVersion attributes generated so the Support dialog
             (and any external version readers) can resolve the product version. They are safe:
             only AssemblyVersion is embedded in WPF BAML pack URIs, which is why that ONE is
             pinned to 1.0.0.0 above. FileVersion + InformationalVersion are display-only. -->
        <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
        <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
        <!-- Strong-name signing disabled — Nice3point.Revit.Toolkit, RevitAPI, and RevitAPIUI
             are unsigned third-party assemblies. A signed assembly cannot load unsigned references
             at runtime in .NET Framework, causing FileLoadException on startup. -->
        <!-- Force binding redirects for net48 assembly version conflicts (Unsafe, etc.) -->
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>

    <!-- Revit configuration -->
    <PropertyGroup Condition="$(Configuration.Contains('R21'))">
        <RevitVersion>2021</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2021;REVIT2021_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R22'))">
        <RevitVersion>2022</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2022;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R23'))">
        <RevitVersion>2023</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2023;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R24'))">
        <RevitVersion>2024</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>REVIT2024;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R25'))">
        <RevitVersion>2025</RevitVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <DefineConstants>REVIT2025;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
        <RevitVersion>2026</RevitVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <DefineConstants>REVIT2026;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R27'))">
        <RevitVersion>2027</RevitVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
        <DefineConstants>REVIT2027;REVIT2021_OR_GREATER;REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER;REVIT2027_OR_GREATER</DefineConstants>
        <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    </PropertyGroup>

    <!-- Fallback: Default to Revit 2024 (net48) since it is the only version on this PC -->
    <PropertyGroup Condition="'$(TargetFramework)' == ''">
        <TargetFramework>net48</TargetFramework>
        <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
        <DefineConstants Condition="'$(RevitVersion)' == '2024'">$(DefineConstants);REVIT2024;REVIT2024_OR_GREATER</DefineConstants>
        <DefineConstants Condition="'$(RevitVersion)' != '2024'">$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    </PropertyGroup>

    <!--
         CopyLocalLockFileAssemblies must be TRUE for all TFMs.
         With EnableDynamicLoading=false, the SDK no longer implicitly copies transitive NuGet
         assemblies. We need them ALL copied to bin (and from there to the publish/addin folder)
         because Revit doesn't supply third-party NuGet packages like CommunityToolkit.Mvvm,
         MaterialDesignThemes, Nice3point.Revit.Toolkit, System.Data.SQLite, etc.

         On net8.0+/net10.0+ the SDK is smart enough to skip framework-provided assemblies
         (System.Text.Json, System.Buffers, etc.) automatically — only actual third-party deps
         get copied. So TRUE here doesn't risk duplicating Revit's runtime assemblies.
    -->
    <PropertyGroup>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- Launch configuration -->
    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
        <StartArguments>/language ENG</StartArguments>
    </PropertyGroup>

    <!-- Build configuration -->
    <!-- https://github.com/Nice3point/Revit.Build.Tasks -->
    <PropertyGroup>
        <IsRepackable>false</IsRepackable>
        <DeployRevitAddin>true</DeployRevitAddin>
        <!-- Set to false to exclude BIManage.Addons from build/deploy -->
        <IncludeAddons Condition="'$(IncludeAddons)' == ''">true</IncludeAddons>
        <!-- Disable VS fast up-to-date check — Nice3point deploy targets copy to
             Revit Addins folder which confuses incremental build timestamp comparison,
             causing builds to appear up-to-date when source files have changed. -->
        <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    </PropertyGroup>

    <!-- Self-heal: if project.assets.json is missing the CURRENT TargetFramework, run a restore
         for the active configuration before ResolvePackageAssets throws NETSDK1005.
         This handles the VS batch-build / config-switch scenario where a prior config's restore
         overwrote the assets file with a different TFM family. We restore for the CURRENT config
         only (not both families) because Nice3point packages are RevitVersion-specific.

         Runs BOTH in design-time and build-time — NETSDK1005 breaks VS Intellisense too. -->
    <Target Name="EnsureCurrentTfmAssets" BeforeTargets="_CheckForInvalidConfigurationAndPlatform;ResolvePackageAssets" Condition="'$(TargetFramework)' != ''">
        <PropertyGroup>
            <_AssetsFile>$(MSBuildProjectDirectory)\obj\project.assets.json</_AssetsFile>
            <_AssetsExists>false</_AssetsExists>
            <_AssetsExists Condition="Exists('$(_AssetsFile)')">true</_AssetsExists>
            <!-- Map TFM to its assets.json "targets" section key. This key identifies
                 which TFM the last restore was for (NOT the package compatibility list). -->
            <_AssetsTargetKey Condition="'$(TargetFramework)' == 'net48'">.NETFramework,Version=v4.8</_AssetsTargetKey>
            <_AssetsTargetKey Condition="'$(TargetFramework)' == 'net8.0-windows'">net8.0-windows7.0</_AssetsTargetKey>
            <_AssetsTargetKey Condition="'$(TargetFramework)' == 'net10.0-windows'">net10.0-windows7.0</_AssetsTargetKey>
            <_AssetsTargetKey Condition="'$(_AssetsTargetKey)' == ''">$(TargetFramework)</_AssetsTargetKey>
            <_HasCurrentTfm Condition="'$(_AssetsExists)' == 'true'">$([System.IO.File]::ReadAllText('$(_AssetsFile)').Contains('"$(_AssetsTargetKey)": {'))</_HasCurrentTfm>
            <_HasCurrentTfm Condition="'$(_HasCurrentTfm)' == ''">false</_HasCurrentTfm>
        </PropertyGroup>
        <Message Text="[BIManage] Self-healing restore for $(Configuration) ($(TargetFramework) → $(_AssetsTargetKey))..." Importance="High" Condition="'$(_HasCurrentTfm)' != 'True'" />
        <Exec Command="dotnet restore &quot;$(MSBuildProjectFullPath)&quot; -p:Configuration=&quot;$(Configuration)&quot; --verbosity quiet" Condition="'$(_HasCurrentTfm)' != 'True'" ContinueOnError="false" />
    </Target>

    <!-- Build BIManage.Addons and copy DLLs into main output BEFORE CoreBuild completes.
         Nice3point's PublishRevitAddinFiles (AfterTargets="CoreBuild") copies $(TargetDir)
         into the publish folder, so Addons must be in $(OutputPath) before that happens.

         ISOLATION STRATEGY: Newtonsoft.Json goes to lib/ subfolder (not flat).
         This prevents conflict with Revit's own Newtonsoft.Json when Revit's
         Cloud Collaboration / external resource subsystems load it. Our addin's
         AssemblyResolve handler probes lib/ on-demand only for OUR code requests. -->
    <Target Name="BuildAddons" AfterTargets="Compile" BeforeTargets="PublishRevitAddinFiles" Condition="'$(IncludeAddons)' == 'true'">
        <MSBuild Projects="BIManage.Addons\BIManage.Addons.csproj" Properties="Configuration=$(Configuration)" Targets="Restore" />
        <MSBuild Projects="BIManage.Addons\BIManage.Addons.csproj" Properties="Configuration=$(Configuration)" Targets="Build" />
        <PropertyGroup>
            <_AddonsOut>BIManage.Addons\bin\$(Configuration)\</_AddonsOut>
        </PropertyGroup>
        <ItemGroup>
            <!-- Flat deployment: our own addon + WindowsAPICodePack (no name conflict with Revit) -->
            <AddonFiles Include="$(_AddonsOut)BIManage.Addons.dll" />
            <AddonFiles Include="$(_AddonsOut)Microsoft.WindowsAPICodePack.*.dll" />
            <!-- lib/ subfolder: assemblies that conflict with Revit's own copies -->
            <AddonLibFiles Include="$(_AddonsOut)Newtonsoft.Json.dll" Condition="Exists('$(_AddonsOut)Newtonsoft.Json.dll')" />
        </ItemGroup>
        <Copy SourceFiles="@(AddonFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(AddonLibFiles)" DestinationFolder="$(OutputPath)lib" SkipUnchangedFiles="true" />
        <!-- Also copy to Revit addins folder if already deployed -->
        <Copy SourceFiles="@(AddonFiles)" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\" SkipUnchangedFiles="true" Condition="Exists('$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\')" />
        <Copy SourceFiles="@(AddonLibFiles)" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\lib\" SkipUnchangedFiles="true" Condition="Exists('$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\')" />
    </Target>

    <!-- Build BIManageRevit.Shim and copy its outputs into the main output BEFORE CoreBuild
         completes. This mirrors BuildAddons. The Shim is the tiny IExternalApplication
         forwarder listed in BIManageRevit.addin's <Assembly> — Revit's manifest scanner
         loads ONLY the Shim into the Default AssemblyLoadContext on R25, and the Shim then
         loads the Core (BIManageRevit.dll) into a dedicated ALC. This eliminates the
         dual-load that surfaces as "Revit encountered a serious error" via native
         AddInManager::commandHasAddinSubscriptions.

         The Shim's runtimeconfig.json + deps.json must be deployed next to BIManageRevit.Shim.dll
         on Revit 2025+ so Revit's add-in loader can set up a coherent ALC for the Shim. -->
    <Target Name="BuildShim" AfterTargets="Compile" BeforeTargets="PublishRevitAddinFiles">
        <MSBuild Projects="BIManageRevit.Shim\BIManageRevit.Shim.csproj" Properties="Configuration=$(Configuration)" Targets="Restore" />
        <MSBuild Projects="BIManageRevit.Shim\BIManageRevit.Shim.csproj" Properties="Configuration=$(Configuration)" Targets="Build" />
        <PropertyGroup>
            <_ShimOut>BIManageRevit.Shim\bin\$(Configuration)\$(TargetFramework)\</_ShimOut>
        </PropertyGroup>
        <ItemGroup>
            <!-- Core Shim binary -->
            <ShimFiles Include="$(_ShimOut)BIManageRevit.Shim.dll" />
            <ShimFiles Include="$(_ShimOut)BIManageRevit.Shim.pdb" Condition="Exists('$(_ShimOut)BIManageRevit.Shim.pdb')" />
            <!-- runtimeconfig.json + deps.json (.NET 8/10 only; net48 doesn't emit them) -->
            <ShimFiles Include="$(_ShimOut)BIManageRevit.Shim.runtimeconfig.json" Condition="Exists('$(_ShimOut)BIManageRevit.Shim.runtimeconfig.json')" />
            <ShimFiles Include="$(_ShimOut)BIManageRevit.Shim.deps.json" Condition="Exists('$(_ShimOut)BIManageRevit.Shim.deps.json')" />
        </ItemGroup>
        <!-- Copy to main output so Nice3point's PublishRevitAddinFiles picks them up. -->
        <Copy SourceFiles="@(ShimFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
        <!-- Also copy directly to the Revit addins folder if already deployed.
             Mirrors BuildAddons line 256 — keeps dev-loop tight (rebuild then re-launch Revit
             without a separate Publish step). -->
        <Copy SourceFiles="@(ShimFiles)" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\" SkipUnchangedFiles="true" Condition="Exists('$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\')" />
    </Target>

    <!-- Remove flat Newtonsoft.Json from OutputPath and deployed addin folder.
         It MUST only exist in lib/ to avoid being pre-loaded and shadowing Revit's copy. -->
    <Target Name="RemoveFlatNewtonsoftJson" AfterTargets="BuildAddons;BuildShim;PublishRevitAddinFiles;DeployRevitAddinFiles">
        <Delete Files="$(OutputPath)Newtonsoft.Json.dll" />
        <Delete Files="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\Newtonsoft.Json.dll" Condition="Exists('$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit\Newtonsoft.Json.dll')" />
    </Target>

    <!-- Restore <ManifestSettings> in the deployed .addin files for Revit 2026+ ONLY.
         Nice3point's PatchManifest task strips the ManifestSettings block during publish for
         "backwards compatibility", but Revit 2026/2027 NEED <UseRevitContext>True</UseRevitContext>
         to prevent the dual-ALC-load that breaks WPF dialogs. We overwrite the patched .addin with
         our source .addin AFTER PatchManifest and DeployRevitAddinFiles run.

         CRITICAL — verified 2026-04-30 against AddInManager.dll string tables:
           Revit 2021-2024 (.NET 4.8):  schema does NOT recognize <ManifestSettings>. Unknown
                                        element silently rejects the entire .addin (no journal entry).
           Revit 2025 (.NET 8):         schema does NOT recognize <ManifestSettings> either. The
                                        parser is stricter and writes a journal error:
                                        "The 'ManifestSettings' tag is incorrect, should be replaced
                                        with 'AddIn'." → manifest fails to load, addin not detected.
           Revit 2026+ (.NET 8/10):     schema recognizes <ManifestSettings><UseRevitContext>.
                                        Required to prevent dual-ALC duplicate load that breaks WPF.

         So <ManifestSettings> may only appear in the deployed .addin for R26+. R21-R25 must be
         the stripped form. PatchManifest already strips it for all targets; this target only
         RE-INJECTS for R26+.

         IMPORTANT: refreshes the .addin in EVERY R26+ Revit Addins folder under %AppData%,
         not just $(RevitVersion). Without this, building for R27 leaves R26's deployed .addin
         stale (no UseRevitContext), which re-introduces the duplicate-load on R26. -->
    <Target Name="PreserveManifestSettings"
            AfterTargets="PatchManifest;DeployRevitAddinFiles;Build"
            Condition="Exists('$(MSBuildProjectDirectory)\BIManageRevit.addin')">
        <PropertyGroup>
            <_AddinSrcPath>$(MSBuildProjectDirectory)\BIManageRevit.addin</_AddinSrcPath>
        </PropertyGroup>
        <!-- Glob both targets:
             1. publish folder (consumed by installer) — matches "Revit XXXX YYY addin/BIManageRevit.addin".
                Filtered to R26+ via the regex on the path: PatchManifest leaves R21-R25 publish
                folders with the (correct) stripped .addin, so we only restore for R26+.
             2. R26+ deployed Revit Addins folders only — fixes stale .addin from prior R-version builds.
                R21-R25 are explicitly excluded so the stripped (no <ManifestSettings>) version stays. -->
        <ItemGroup>
            <_AllPublishedAddins Include="$(PublishDir)**\BIManageRevit.addin" />
            <_PublishedAddins Include="@(_AllPublishedAddins)"
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', 'Revit\s20(2[6-9]|[3-9]\d)'))" />
            <_DeployedAddins Include="$(AppData)\Autodesk\Revit\Addins\2026\BIManageRevit.addin" />
            <_DeployedAddins Include="$(AppData)\Autodesk\Revit\Addins\2027\BIManageRevit.addin" />
            <_DeployedAddins Include="$(AppData)\Autodesk\Revit\Addins\2028\BIManageRevit.addin" />
            <_DeployedAddins Include="$(AppData)\Autodesk\Revit\Addins\2029\BIManageRevit.addin" />
        </ItemGroup>
        <Message Text="[PreserveManifestSettings] R26+ only - published=@(_PublishedAddins) deployed=@(_DeployedAddins)" Importance="High" />
        <!-- Use a metadata transform so SourceFiles count matches DestinationFiles count.
             '@(_PublishedAddins->'$(_AddinSrcPath)')' produces one copy of $(_AddinSrcPath)
             per item in @(_PublishedAddins), keeping MSBuild's Copy task happy when copying
             one source file out to N destinations (R2026-R2029 deployed addins). -->
        <Copy SourceFiles="@(_PublishedAddins->'$(_AddinSrcPath)')"
              DestinationFiles="@(_PublishedAddins)"
              SkipUnchangedFiles="false"
              OverwriteReadOnlyFiles="true"
              Condition="'@(_PublishedAddins)' != ''" />
        <Copy SourceFiles="@(_DeployedAddins->'$(_AddinSrcPath)')"
              DestinationFiles="@(_DeployedAddins)"
              SkipUnchangedFiles="false"
              OverwriteReadOnlyFiles="true"
              Condition="'@(_DeployedAddins)' != '' AND Exists('%(_DeployedAddins.Identity)')" />
    </Target>

    <!-- DEFENSIVE: After build, if R25's deployed .addin contains <ManifestSettings> from a
         prior bad build, strip it. R25's manifest parser explicitly rejects ManifestSettings
         ("The 'ManifestSettings' tag is incorrect, should be replaced with 'AddIn'") and the
         entire addin fails to load. This target rewrites a clean stripped version when needed. -->
    <Target Name="StripR25ManifestSettings"
            AfterTargets="PatchManifest;DeployRevitAddinFiles;Build">
        <PropertyGroup>
            <_R25Addin>$(AppData)\Autodesk\Revit\Addins\2025\BIManageRevit.addin</_R25Addin>
        </PropertyGroup>
        <ItemGroup>
            <_R25Publish Include="$(PublishDir)**\BIManageRevit.addin"
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', 'Revit\s2025'))" />
        </ItemGroup>
        <Exec Command="powershell -NoProfile -Command &quot;$f='$(_R25Addin)'; if (Test-Path $f) { $c=Get-Content $f -Raw; if ($c -match '&lt;ManifestSettings&gt;') { $c2=[regex]::Replace($c, '(?s)\s*&lt;!--.*?--&gt;\s*&lt;ManifestSettings&gt;.*?&lt;/ManifestSettings&gt;\s*', ''); $c2=[regex]::Replace($c2, '(?s)\s*&lt;ManifestSettings&gt;.*?&lt;/ManifestSettings&gt;\s*', ''); Set-Content -Path $f -Value $c2 -Encoding UTF8 -NoNewline; Write-Host '[StripR25ManifestSettings] Stripped from' $f } }&quot;"
              Condition="Exists('$(_R25Addin)')"
              ContinueOnError="true" />
        <Exec Command="powershell -NoProfile -Command &quot;$f='%(_R25Publish.Identity)'; if (Test-Path $f) { $c=Get-Content $f -Raw; if ($c -match '&lt;ManifestSettings&gt;') { $c2=[regex]::Replace($c, '(?s)\s*&lt;!--.*?--&gt;\s*&lt;ManifestSettings&gt;.*?&lt;/ManifestSettings&gt;\s*', ''); $c2=[regex]::Replace($c2, '(?s)\s*&lt;ManifestSettings&gt;.*?&lt;/ManifestSettings&gt;\s*', ''); Set-Content -Path $f -Value $c2 -Encoding UTF8 -NoNewline; Write-Host '[StripR25ManifestSettings] Stripped from' $f } }&quot;"
              Condition="'@(_R25Publish)' != ''"
              ContinueOnError="true" />

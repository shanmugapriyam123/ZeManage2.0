        <_IsReleaseBuild Condition="$(Configuration.Contains('Release'))">true</_IsReleaseBuild>
        <_IsReleaseBuild Condition="$(Configuration.Contains('Debug'))">false</_IsReleaseBuild>
        <_SecurityDir>$(MSBuildProjectDirectory)\Tools\Security</_SecurityDir>
    </PropertyGroup>

    <Target Name="GenerateSBOM" AfterTargets="Build" Condition="'$(_IsReleaseBuild)' == 'true'">
        <MakeDir Directories="$(_SecurityDir)" Condition="!Exists('$(_SecurityDir)')" />
        <Exec Command="dotnet dotnet-CycloneDX &quot;$(MSBuildProjectFullPath)&quot; -o &quot;$(_SecurityDir)&quot; --filename sbom.json --json --exclude-dev --disable-package-restore" IgnoreExitCode="true" ContinueOnError="true" Timeout="120000" />
        <Message Text="SBOM generated at Tools\Security\sbom.json" Importance="high" Condition="Exists('$(_SecurityDir)\sbom.json')" />
    </Target>

    <Target Name="GenerateSCA" AfterTargets="GenerateSBOM" Condition="'$(_IsReleaseBuild)' == 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\SCA\RunSCA.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -OutputDir &quot;$(_SecurityDir)&quot;" IgnoreExitCode="true" ContinueOnError="true" Timeout="180000" />
        <Message Text="SCA report generated at Tools\Security\sca-report.json" Importance="high" />
    </Target>

    <Target Name="GenerateSAST" AfterTargets="GenerateSCA" Condition="'$(_IsReleaseBuild)' == 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\SAST\RunSAST.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -Configuration &quot;$(Configuration)&quot; -OutputDir &quot;$(_SecurityDir)&quot;" IgnoreExitCode="true" ContinueOnError="true" Timeout="300000" />
        <Message Text="SAST report generated at Tools\Security\sast-report.json" Importance="high" />
    </Target>

    <Target Name="GenerateDAST" AfterTargets="GenerateSAST" Condition="'$(_IsReleaseBuild)' == 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\DAST\RunDAST.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -OutputDir &quot;$(_SecurityDir)&quot;" IgnoreExitCode="true" ContinueOnError="true" Timeout="300000" />
        <Message Text="DAST report generated at Tools\Security\dast-report.json" Importance="high" />
    </Target>

</Project>
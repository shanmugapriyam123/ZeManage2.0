    <!-- Post-build: Copy SQLite.Interop.dll for Revit compatibility.
         Runs after CoreBuild (compile + content copy) but BEFORE Nice3point's
         PublishRevitAddinFiles, so the .dll is in $(OutputPath) when publish copies $(TargetDir). -->
    <Target Name="CopySQLiteNativeDll" AfterTargets="CoreBuild" BeforeTargets="PublishRevitAddinFiles">
        <Message Text="═══════════════════════════════════════════════════════" Importance="high" />
        <Message Text="  Copying SQLite.Interop.dll (Required for Database)" Importance="high" />
        <Message Text="  Target Framework: $(TargetFramework)" Importance="high" />
        <Message Text="  Output Path: $(OutputPath)" Importance="high" />
        <Message Text="═══════════════════════════════════════════════════════" Importance="high" />

        <!-- For .NET 8.0 (Revit 2025+): Copy from runtimes folder to root -->
        <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\SQLite.Interop.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)runtimes\win-x64\native\SQLite.Interop.dll')" />
        <Message Text="✓ SQLite.Interop.dll copied from runtimes\win-x64\native\" Importance="high" Condition="Exists('$(OutputPath)runtimes\win-x64\native\SQLite.Interop.dll')" />

        <!-- For .NET Framework 4.8 (Revit 2021-2024): Copy from x64 folder to root -->
        <Copy SourceFiles="$(OutputPath)x64\SQLite.Interop.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
        <Message Text="✓ SQLite.Interop.dll copied from x64\" Importance="high" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />

        <!-- Fallback: Try copying from NuGet packages cache.
             The actual native DLL lives in Stub.System.Data.SQLite.Core.NetFramework (net48)
             or Stub.System.Data.SQLite.Core.NetStandard (net8.0+) — NOT in System.Data.SQLite.Core
             which is just a metapackage. Build also copies to OutputPath\x64\ AND OutputPath\x86\.
             This fallback ensures both are present even if the Stub package's BuildDependsOn
             hook didn't fire (e.g. fresh restore + build race on net48 R21/R22/R23). -->
        <PropertyGroup>
            <SQLiteStubNetFw>$(UserProfile)\.nuget\packages\stub.system.data.sqlite.core.netframework\1.0.118\build\net46</SQLiteStubNetFw>
            <SQLiteStubNetStd>$(UserProfile)\.nuget\packages\stub.system.data.sqlite.core.netstandard\1.0.118\runtimes\win-x64\native</SQLiteStubNetStd>
        </PropertyGroup>
        <!-- net48: copy from net46/x64 + net46/x86 in Stub.System.Data.SQLite.Core.NetFramework -->
        <Copy SourceFiles="$(SQLiteStubNetFw)\x64\SQLite.Interop.dll" DestinationFolder="$(OutputPath)x64" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(TargetFramework)' == 'net48' AND !Exists('$(OutputPath)x64\SQLite.Interop.dll') AND Exists('$(SQLiteStubNetFw)\x64\SQLite.Interop.dll')" />
        <Copy SourceFiles="$(SQLiteStubNetFw)\x86\SQLite.Interop.dll" DestinationFolder="$(OutputPath)x86" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(TargetFramework)' == 'net48' AND !Exists('$(OutputPath)x86\SQLite.Interop.dll') AND Exists('$(SQLiteStubNetFw)\x86\SQLite.Interop.dll')" />
        <Copy SourceFiles="$(SQLiteStubNetFw)\x64\SQLite.Interop.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(TargetFramework)' == 'net48' AND !Exists('$(OutputPath)SQLite.Interop.dll') AND Exists('$(SQLiteStubNetFw)\x64\SQLite.Interop.dll')" />
        <Message Text="✓ SQLite.Interop.dll copied from Stub.NetFramework NuGet cache (fallback for net48)" Importance="high" Condition="'$(TargetFramework)' == 'net48' AND Exists('$(SQLiteStubNetFw)\x64\SQLite.Interop.dll')" />
        <!-- net8.0+/net10.0+: copy from runtimes/win-x64/native in Stub.System.Data.SQLite.Core.NetStandard -->
        <Copy SourceFiles="$(SQLiteStubNetStd)\SQLite.Interop.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(TargetFramework)' != 'net48' AND !Exists('$(OutputPath)SQLite.Interop.dll') AND Exists('$(SQLiteStubNetStd)\SQLite.Interop.dll')" />
        <Message Text="✓ SQLite.Interop.dll copied from Stub.NetStandard NuGet cache (fallback for net core)" Importance="high" Condition="'$(TargetFramework)' != 'net48' AND Exists('$(SQLiteStubNetStd)\SQLite.Interop.dll')" />

        <!-- Also copy to Revit addins folder -->
        <PropertyGroup>
            <RevitAddinsDir Condition="'$(RevitAddinsDir)' == ''">$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIManageRevit</RevitAddinsDir>
        </PropertyGroup>
        <Copy SourceFiles="$(OutputPath)SQLite.Interop.dll" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(OutputPath)SQLite.Interop.dll') AND Exists('$(RevitAddinsDir)')" />
        <Message Text="SQLite.Interop.dll deployed to Revit addins folder" Importance="high" Condition="Exists('$(OutputPath)SQLite.Interop.dll') AND Exists('$(RevitAddinsDir)')" />
    </Target>


